module

public import Mathlib.Algebra.Order.Field.Basic
public import Mathlib.Data.ENat.Lattice
public import Mathlib.Data.Matrix.Mul

/-!
# Extended formulations and extension complexity

Let `K` be a linearly ordered field and `P ⊆ K^d`. An extended formulation of `P` is a finite
system `E x + F y ≤ g`, `E' x + F' y = g'` whose feasible pairs `(x, y)` project onto `P` in the
`x` coordinates. Its size counts inequality rows only. The extension complexity is the least
size, or `⊤` if `P` has no extended formulation. The slack matrix of a polytope described by
`A x ≤ b` and generated by the listed points `v` has entries `b i - (A *ᵥ v j) i`. The formula
also applies to any list of points, and the entries are nonnegative if the points satisfy
`A x ≤ b`.

## References

* Samuel Fiorini, Serge Massar, Sebastian Pokutta, Hans Raj Tiwary, and Ronald de Wolf,
  *Exponential Lower Bounds for Polytopes in Combinatorial Optimization*, Journal of the ACM
  62(2), Article 17 (2015), pp. 17:1–17:23, §1.1, equation (1) and the size convention,
  and §3, the slack matrix and extension complexity.
* Mihalis Yannakakis, *Expressing Combinatorial Optimization Problems by Linear Programs*,
  Journal of Computer and System Sciences 43(3) (1991), pp. 441–466. The original factorization
  result is credited in Fiorini et al., §3.1; we use the definitions, not the rank identity.
-/

public section

set_option autoImplicit false

namespace Cslib.Algorithms.Lean.ExtensionComplexity

variable {K : Type*} {d m n : ℕ}

/-- **Extended formulation.** For `P ⊆ K^d` over a linearly ordered field `K`, an extended
formulation consists of finitely many inequalities `E x + F y ≤ g` (componentwise) and equations
`E' x + F' y = g'`. It requires that `x ∈ P` if and only if some `y ∈ K^auxDim` satisfies both
systems. The size is `ineqRows`; equations and auxiliary variables are not counted. Any of the
dimensions may be zero: a system with no rows imposes no conditions, and with no auxiliary
variables the witness is the unique empty vector. There is no boundedness requirement on the
lifted feasible set.

Source: Fiorini, Massar, Pokutta, Tiwary, and de Wolf (2015), §1.1, equation (1) and the paragraph
that defines size, stated here over a linearly ordered field rather than just `ℝ`. -/
structure ExtendedFormulation [Field K] [LinearOrder K] [IsStrictOrderedRing K]
    (P : Set (Fin d → K)) where
  /-- **Auxiliary dimension.** The number of extra variables. -/
  auxDim : ℕ
  /-- **Size.** The number of inequality rows. -/
  ineqRows : ℕ
  /-- **Equation count.** The number of equation rows, not included in the size. -/
  eqRows : ℕ
  /-- **Inequality coefficients on the original variables.** The matrix `E`. -/
  ineqX : Matrix (Fin ineqRows) (Fin d) K
  /-- **Inequality coefficients on the extra variables.** The matrix `F`. -/
  ineqY : Matrix (Fin ineqRows) (Fin auxDim) K
  /-- **Inequality right-hand side.** The vector `g`. -/
  ineqRhs : Fin ineqRows → K
  /-- **Equation coefficients on the original variables.** The matrix `E'`. -/
  eqX : Matrix (Fin eqRows) (Fin d) K
  /-- **Equation coefficients on the extra variables.** The matrix `F'`. -/
  eqY : Matrix (Fin eqRows) (Fin auxDim) K
  /-- **Equation right-hand side.** The vector `g'`. -/
  eqRhs : Fin eqRows → K
  /-- **Projection property.** A point belongs to `P` exactly when it has a feasible lift. -/
  mem_iff (x : Fin d → K) : x ∈ P ↔ ∃ y : Fin auxDim → K,
    ineqX.mulVec x + ineqY.mulVec y ≤ ineqRhs ∧ eqX.mulVec x + eqY.mulVec y = eqRhs

section OrderedField

variable [Field K] [LinearOrder K] [IsStrictOrderedRing K]

/-- **Extension complexity.** For `P ⊆ K^d` over a linearly ordered field `K`, the extension
complexity is the minimum number of inequality rows in any extended formulation of `P`. The
minimum is attained whenever a formulation exists. The value is `⊤ : ℕ∞` when none exists.

Source: Fiorini, Massar, Pokutta, Tiwary, and de Wolf (2015), §1.1, “Symmetry Matters.” -/
noncomputable def extensionComplexity (P : Set (Fin d → K)) : ℕ∞ :=
  ⨅ F : ExtendedFormulation P, (F.ineqRows : ℕ∞)

/-- **Finite upper bounds on extension complexity.** For `P ⊆ K^d` over a linearly ordered field
and `r : ℕ`, the extension complexity of `P` is at most `r` exactly when `P` has an extended
formulation with at most `r` inequality rows. -/
theorem extensionComplexity_le_iff {P : Set (Fin d → K)} {r : ℕ} :
    extensionComplexity P ≤ r ↔ ∃ F : ExtendedFormulation P, F.ineqRows ≤ r := by
  unfold extensionComplexity
  constructor
  · intro h
    have : Nonempty (ExtendedFormulation P) :=
      ENat.iInf_natCast_lt_top.mp (h.trans_lt (ENat.natCast_lt_top r))
    obtain ⟨F, hF⟩ := ENat.exists_eq_iInf (fun F : ExtendedFormulation P => (F.ineqRows : ℕ∞))
    exact ⟨F, ENat.natCast_le_natCast.mp (hF.le.trans h)⟩
  · rintro ⟨F, hF⟩
    exact (iInf_le _ F).trans (ENat.natCast_le_natCast.mpr hF)

/-- **Infinite extension complexity.** For `P ⊆ K^d` over a linearly ordered field, the extension
complexity is `⊤` exactly when no extended formulation of `P` exists. -/
theorem extensionComplexity_eq_top_iff {P : Set (Fin d → K)} :
    extensionComplexity P = ⊤ ↔ IsEmpty (ExtendedFormulation P) :=
  ENat.iInf_natCast_eq_top

end OrderedField

variable [Field K]

/-- **Slack matrix.** Over a field `K`, given a coefficient matrix `A` with `m` rows
in ambient dimension `d`, and `n` listed points `v j ∈ K^d`, the entry in row `i` and column `j`
is `b i - (A *ᵥ v j) i`. In particular, this gives the slack matrix of a polytope described both
by `A x ≤ b` and as the convex hull of the listed points. The formula is defined for arbitrary
points; nonnegativity requires feasibility, not that the points generate the entire polytope.

Source: Fiorini, Massar, Pokutta, Tiwary, and de Wolf (2015), §3, opening definition. -/
def slackMatrix (A : Matrix (Fin m) (Fin d) K) (b : Fin m → K)
    (v : Fin n → Fin d → K) : Matrix (Fin m) (Fin n) K :=
  Matrix.of fun i j => b i - (A.mulVec (v j)) i

/-- **Slack entry.** For a coefficient row `i` and a listed point `v j` over a field, its slack
is the row's right-hand side minus the row evaluated at that point. -/
theorem slackMatrix_apply (A : Matrix (Fin m) (Fin d) K) (b : Fin m → K)
    (v : Fin n → Fin d → K) (i : Fin m) (j : Fin n) :
    slackMatrix A b v i j = b i - (A.mulVec (v j)) i := by
  simp [slackMatrix]

variable [LinearOrder K] [IsStrictOrderedRing K]

/-- **Nonnegative slack at feasible points.** If each listed point satisfies `A x ≤ b`
componentwise over a linearly ordered field, every entry of the associated slack matrix is
nonnegative. -/
theorem slackMatrix_nonneg {A : Matrix (Fin m) (Fin d) K} {b : Fin m → K}
    {v : Fin n → Fin d → K} (h : ∀ j, A.mulVec (v j) ≤ b) (i : Fin m) (j : Fin n) :
    0 ≤ slackMatrix A b v i j := by
  rw [slackMatrix_apply]
  exact sub_nonneg.mpr (h j i)

end Cslib.Algorithms.Lean.ExtensionComplexity

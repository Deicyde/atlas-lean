module

public import MathlibExt.Algebra.MonoidAlgebra.KolyvaginDerivative

/-!
# Tests for `MathlibExt.Algebra.MonoidAlgebra.KolyvaginDerivative`
-/

set_option autoImplicit false

@[expose] public section

open Finset

#check @MonoidAlgebra.of_sub_one_mul_sum_smul_of_pow_and_iff

/-- For a group of order `3` generated by `σ` (`ℓ = 2`): `(σ - 1)(σ + 2 σ²) = 3 - Tr`, written
out. -/
example {G : Type*} [Group G] [Fintype G] (σ : G) (hσ : ∀ g : G, g ∈ Subgroup.zpowers σ)
    (hcard : Fintype.card G = 3) :
    (MonoidAlgebra.of ℤ G σ - 1) *
        (MonoidAlgebra.of ℤ G σ + (2 : ℤ) • MonoidAlgebra.of ℤ G (σ ^ 2)) =
      3 - ∑ g : G, MonoidAlgebra.of ℤ G g := by
  have h := (MonoidAlgebra.of_sub_one_mul_sum_smul_of_pow_and_iff (ℓ := 2) σ hσ hcard).1
  simpa [sum_range_succ, two_smul] using h

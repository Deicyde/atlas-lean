module

public import MathlibExt.LinearAlgebra.Eigenspace.JointEigenvector
import Mathlib.Algebra.Algebra.Subalgebra.Lattice

#check @Module.exists_ne_zero_forall_mem_smul_eq_zero
#check @Module.exists_ne_zero_forall_smul_eq_algHom
#check @Module.End.exists_ne_zero_forall_apply_eq_smul_of_algHom

-- The subalgebra generated by one endomorphism `T` is commutative (an instance); a character
-- sending `T` to `μ` gives an eigenvector of `T` with eigenvalue `μ`.
example {K V : Type*} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (T : Module.End K V) (χ : Algebra.adjoin K {T} →ₐ[K] K) :
    ∃ v : V, v ≠ 0 ∧ T v = χ ⟨T, Algebra.self_mem_adjoin_singleton K T⟩ • v := by
  obtain ⟨v, hv, h⟩ := Module.End.exists_ne_zero_forall_apply_eq_smul_of_algHom
    (Algebra.adjoin K {T}) χ
  exact ⟨v, hv, h ⟨T, Algebra.self_mem_adjoin_singleton K T⟩⟩

-- A field acting on itself: the only character is the identity, with eigenvector `1`.
example {K : Type*} [Field K] (χ : K →ₐ[K] K) : ∃ v : K, v ≠ 0 ∧ ∀ a : K, a • v = χ a • v :=
  Module.exists_ne_zero_forall_smul_eq_algHom χ

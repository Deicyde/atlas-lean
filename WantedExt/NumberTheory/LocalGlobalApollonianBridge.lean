module

public import MathlibExt.Geometry.Euclidean.ApollonianDescartesQuadruples
public import WantedExt.NumberTheory.LocalGlobalApollonianCirclePackingsWanted

/-!
# Bridge: the Haag–Kertzer–Rickards–Stange Apollonian group and the proved Apollonian algebra

The local-global statements of Haag, Kertzer, Rickards and Stange
(`WantedExt.NumberTheory.LocalGlobalApollonianCirclePackingsWanted`) define the Descartes form by a
matrix, the generators `S₁, …, S₄` as elements of `GL₄(ℤ)` and the Apollonian group as the
subgroup they generate. The proved library
(`MathlibExt.Geometry.Euclidean.ApollonianDescartesQuadruples`) works with the Descartes form, the
flips and the Apollonian orbit over any commutative ring. This file proves that the two encodings
agree over `ℤ`: the matrix form is the Descartes form, each `Sᵢ` acts as the `i`-th flip (so the
Haag–Kertzer–Rickards–Stange group is generated by the orthogonal reflections of the Descartes
form), and the orbit of a quadruple under the Apollonian group is its Apollonian orbit.

The proofs are proved Lean, not wanted statements; they live in `WantedExt` because `MathlibExt`
cannot import the Haag–Kertzer–Rickards–Stange definitions.
-/

@[expose] public section

namespace MathlibExt.NumberTheory.LocalGlobalApollonianBridge

open Matrix MathlibExt.Geometry.Euclidean.ApollonianDescartesQuadruples
open MathlibExt.NumberTheory.LocalGlobalApollonianCirclePackingsWanted
open LocalGlobalApollonianCirclePackings

/-- **The Descartes matrix represents the Descartes form.** For every integer quadruple `v`,
`vᵀ M v = Q(v) = 2 (v₁² + v₂² + v₃² + v₄²) - (v₁ + v₂ + v₃ + v₄)²`, where `M` is the matrix
`DescartesMatrix` of the local-global statements (Kontorovich and Oh, arXiv:0811.2236v5,
Section 2.1, for the Descartes form). -/
theorem descartesMatrix_form (v : Fin 4 → ℤ) :
    v ᵥ* DescartesMatrix ⬝ᵥ v = descartesForm v := by
  simp [DescartesMatrix, descartesForm, vecMul_eq_sum, dotProduct, Fin.sum_univ_four]
  ring

/-- **The four Apollonian generators as a family.** `apollonianGenerator i` is the generator
`S₍ᵢ₊₁₎` of the Apollonian group of the local-global statements, the matrices `S₁, …, S₄` of
Kontorovich and Oh (arXiv:0811.2236v5, introduction). -/
def apollonianGenerator : Fin 4 → GL (Fin 4) ℤ := ![S₁, S₂, S₃, S₄]

/-- **Each Apollonian generator acts as an Apollonian flip.** The matrix `Sᵢ` sends a quadruple `v`
to `apollonianFlip i v`, which replaces `vᵢ` by `2 · (sum of the other three entries) - vᵢ`; by
`apollonianFlip_eq_reflection` this is the orthogonal reflection of the Descartes form along the
`i`-th basis vector (Kontorovich and Oh, arXiv:0811.2236v5, equation (1.3)). -/
theorem apollonianGenerator_smul (i : Fin 4) (v : Fin 4 → ℤ) :
    apollonianGenerator i • v = apollonianFlip i v := by
  rw [GeneralLinearGroup.smul_def]
  funext j
  fin_cases i <;> fin_cases j <;>
    simp [apollonianGenerator, apollonianFlip, mulVec, dotProduct, Fin.sum_univ_four,
      Function.update] <;> ring

private theorem apollonianGenerator_inv (i : Fin 4) :
    (apollonianGenerator i)⁻¹ = apollonianGenerator i := by
  fin_cases i <;> exact Units.ext rfl

private theorem generators_eq :
    ({S₁, S₂, S₃, S₄} : Set (GL (Fin 4) ℤ)) = Set.range apollonianGenerator := by
  ext g
  constructor
  · rintro (rfl | rfl | rfl | rfl)
    exacts [⟨0, rfl⟩, ⟨1, rfl⟩, ⟨2, rfl⟩, ⟨3, rfl⟩]
  · rintro ⟨i, rfl⟩
    fin_cases i
    exacts [Or.inl rfl, Or.inr (Or.inl rfl), Or.inr (Or.inr (Or.inl rfl)),
      Or.inr (Or.inr (Or.inr rfl))]

private theorem smul_mem_apollonianOrbit {g : GL (Fin 4) ℤ} (hg : g ∈ ApollonianGroup)
    (v : Fin 4 → ℤ) : ∀ w ∈ apollonianOrbit v, g • w ∈ apollonianOrbit v := by
  rw [ApollonianGroup, generators_eq] at hg
  induction hg using Subgroup.closure_induction'' with
  | mem g hg =>
    obtain ⟨i, rfl⟩ := hg
    intro w hw
    rw [apollonianGenerator_smul]
    exact apollonianFlip_mem_apollonianOrbit i hw
  | inv_mem g hg =>
    obtain ⟨i, rfl⟩ := hg
    intro w hw
    rw [apollonianGenerator_inv, apollonianGenerator_smul]
    exact apollonianFlip_mem_apollonianOrbit i hw
  | one => intro w hw; simpa using hw
  | mul g h _ _ hg hh => intro w hw; rw [mul_smul]; exact hg _ (hh w hw)

/-- **The Apollonian group orbit is the Apollonian orbit.** For every integer quadruple `v`, the
orbit `{g • v : g ∈ ApollonianGroup}` under the Apollonian group of Haag, Kertzer, Rickards and
Stange equals `apollonianOrbit v`, the set of quadruples obtained from `v` by finitely many
flips (Kontorovich and Oh, arXiv:0811.2236v5, Section 2.1). -/
theorem apollonianGroup_orbit_eq (v : Fin 4 → ℤ) :
    {w | ∃ g ∈ ApollonianGroup, g • v = w} = apollonianOrbit v := by
  ext w
  constructor
  · rintro ⟨g, hg, rfl⟩
    exact smul_mem_apollonianOrbit hg v v (self_mem_apollonianOrbit v)
  · rintro ⟨l, rfl⟩
    induction l with
    | nil => exact ⟨1, one_mem _, one_smul _ _⟩
    | cons i l ih =>
      obtain ⟨g, hg, hgv⟩ := ih
      refine ⟨apollonianGenerator i * g, mul_mem (Subgroup.subset_closure ?_) hg, ?_⟩
      · rw [generators_eq]
        exact ⟨i, rfl⟩
      · rw [mul_smul, hgv, apollonianGenerator_smul]
        rfl

end MathlibExt.NumberTheory.LocalGlobalApollonianBridge

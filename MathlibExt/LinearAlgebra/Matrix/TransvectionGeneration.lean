/-!
# Generation of the special linear group by elementary transvections

Over a field `F`, for a finite index set `n`:

* `Matrix.GeneralLinearGroup.diagonal_mem_closure_transvections`: a diagonal matrix of
  determinant `1` is a product of elementary transvections `1 + c e_{ij}`, `i ≠ j`, `c ≠ 0`;
* `Matrix.GeneralLinearGroup.range_toGL_eq_closure_transvections`: `SL_n(F)` is the subgroup of
  `GL_n(F)` generated by the elementary transvections;
* `Matrix.GeneralLinearGroup.range_toGL_eq_closure_conj_upperTriangular`: for `n` linearly
  ordered, `SL_n(F)` is generated by the `GL_n(F)`-conjugates of the upper unitriangular matrices;
* `Matrix.GeneralLinearGroup.exists_unique_eq_comp_det`: a homomorphism from `GL_n(F)` to a
  commutative group that is trivial on the upper unitriangular matrices is `χ ∘ det` for a unique
  `χ : Fˣ →* A`, for `n` nonempty.

The diagonal case rests on the factorization of `diag(a, a⁻¹)` into four transvection matrices,
hence at most four elementary transvections after omitting identity factors
(`Matrix.GeneralLinearGroup.diagonal_pair_eq_transvection_mul`).

## References

* K. Conrad, *Simplicity of `PSL_n(F)`*, expository note: §3, proof of Theorem 3.3, p. 4; §4,
  Theorem 4.5, p. 8, for `n ≥ 2` (the Lean statements also cover `n` with at most one element,
  where both subgroups are trivial).
* T. Wedhorn, *The local Langlands correspondence for GL(n) over p-adic fields*,
  arXiv:math/0011210 (version 2): (2.1.18) and its proof, pp. 19–20.
-/

@[expose] public section

set_option autoImplicit false

open Matrix

namespace Matrix.GeneralLinearGroup

variable {n : Type*} [Fintype n] [DecidableEq n] {F : Type*} [Field F]

/-- **A diagonal matrix $\mathrm{diag}(a, a^{-1})$ as a product of four transvections.** Let
$p \neq q$ be indices and $a \in F^\times$. The diagonal matrix with $a$ in position $p$,
$a^{-1}$ in position $q$ and $1$ elsewhere is
$$(1 + \tfrac{1-a}{a} e_{qp})(1 + e_{pq})(1 + (a - 1) e_{qp})(1 - a^{-1} e_{pq}),$$
with `Matrix.transvection i j c` $= 1 + c\, e_{ij}$: four transvection matrices, hence at most four
elementary transvections after omitting identity factors (for $a = 1$ the first and third factors
are the identity).

Source: K. Conrad, *Simplicity of $\mathrm{PSL}_n(F)$*, expository note,
<https://kconrad.math.uconn.edu/blurbs/grouptheory/PSLnsimple.pdf>,
§3, proof of Theorem 3.3, p. 4, the factorization of
$\begin{pmatrix} a & 0 \\ 0 & 1/a \end{pmatrix}$, here on the coordinates $p, q$. -/
theorem diagonal_pair_eq_transvection_mul {p q : n} (hpq : p ≠ q) {a : F} (ha : a ≠ 0) :
    diagonal (fun k => if k = p then a else if k = q then a⁻¹ else 1) =
      Matrix.transvection q p ((1 - a) / a) * Matrix.transvection p q 1 *
        Matrix.transvection q p (a - 1) * Matrix.transvection p q (-a⁻¹) := by
  have hqp : q ≠ p := hpq.symm
  simp only [Matrix.transvection, add_mul, mul_add, one_mul, mul_one, single_mul_single_same,
    single_mul_single_of_ne _ _ _ _ hpq, single_mul_single_of_ne _ _ _ _ hqp, add_zero,
    ← add_assoc]
  ext k l
  simp only [Matrix.add_apply, Matrix.single_apply, Matrix.one_apply, Matrix.diagonal_apply]
  by_cases hkp : p = k <;> by_cases hkq : q = k <;> by_cases hlp : p = l <;>
    by_cases hlq : q = l <;> simp_all [eq_comm (a := k)] <;> field_simp <;> ring

/-- Every transvection $1 + c\, e_{ij}$, $i \neq j$, of $\mathrm{GL}_n(F)$ lies in the subgroup
generated by the elementary transvections, those with $c \neq 0$; for $c = 0$ it is the
identity. -/
theorem transvection_mem_closure {i j : n} (hij : i ≠ j) (c : F) :
    GeneralLinearGroup.transvection i j hij c ∈ Subgroup.closure
      {g : GL n F | ∃ i j : n, ∃ c : F, i ≠ j ∧ c ≠ 0 ∧
        (g : Matrix n n F) = Matrix.transvection i j c} := by
  by_cases hc : c = 0
  · have : GeneralLinearGroup.transvection i j hij c = 1 := by
      ext : 1
      simp [GeneralLinearGroup.transvection, hc, Matrix.transvection_zero]
    rw [this]
    exact Subgroup.one_mem _
  · exact Subgroup.subset_closure ⟨i, j, c, hij, hc, rfl⟩

/-- For $p \neq q$ and $a \in F^\times$, the diagonal matrix with $a$ in position $p$, $a^{-1}$ in
position $q$ and $1$ elsewhere lies in the subgroup of $\mathrm{GL}_n(F)$ generated by the
elementary transvections $1 + c\, e_{ij}$, $i \neq j$, $c \neq 0$. -/
theorem diagonal_pair_mem_closure {p q : n} (hpq : p ≠ q) {a : F} (ha : a ≠ 0) (g : GL n F)
    (hg : (g : Matrix n n F) = diagonal fun k => if k = p then a else if k = q then a⁻¹ else 1) :
    g ∈ Subgroup.closure
      {g : GL n F | ∃ i j : n, ∃ c : F, i ≠ j ∧ c ≠ 0 ∧
        (g : Matrix n n F) = Matrix.transvection i j c} := by
  have hqp : q ≠ p := hpq.symm
  have : g = GeneralLinearGroup.transvection q p hqp ((1 - a) / a) *
      GeneralLinearGroup.transvection p q hpq 1 * GeneralLinearGroup.transvection q p hqp (a - 1) *
        GeneralLinearGroup.transvection p q hpq (-a⁻¹) := by
    ext : 1
    rw [hg, diagonal_pair_eq_transvection_mul hpq ha]
    rfl
  rw [this]
  exact mul_mem (mul_mem (mul_mem (transvection_mem_closure _ _) (transvection_mem_closure _ _))
    (transvection_mem_closure _ _)) (transvection_mem_closure _ _)

/-- **A diagonal matrix of determinant one is a product of elementary transvections.** Let $F$ be a
field and $D = \mathrm{diag}(d_i)_{i \in n}$ with $\prod_i d_i = 1$. Then $D$, as an element of
$\mathrm{GL}_n(F)$, lies in the subgroup generated by the elementary transvections
$1 + c\, e_{ij}$, $i \neq j$, $c \in F^\times$: for a fixed index $i_0$, $D$ is the product over
$j \neq i_0$ of the diagonal matrices with $d_j$ in position $j$ and $d_j^{-1}$ in position $i_0$,
each a product of four transvection matrices, hence of at most four elementary transvections after
omitting identity factors.

Source: K. Conrad, *Simplicity of $\mathrm{PSL}_n(F)$*, expository note,
<https://kconrad.math.uconn.edu/blurbs/grouptheory/PSLnsimple.pdf>,
§3, proof of Theorem 3.3, p. 4, the factorization of
$\begin{pmatrix} a & 0 \\ 0 & 1/a \end{pmatrix}$ into at most four elementary matrices. -/
theorem diagonal_mem_closure_transvections {D : n → F} (hD : ∏ i, D i = 1) (g : GL n F)
    (hg : (g : Matrix n n F) = diagonal D) :
    g ∈ Subgroup.closure
      {g : GL n F | ∃ i j : n, ∃ c : F, i ≠ j ∧ c ≠ 0 ∧
        (g : Matrix n n F) = Matrix.transvection i j c} := by
  classical
  set S := {g : GL n F | ∃ i j : n, ∃ c : F, i ≠ j ∧ c ≠ 0 ∧
    (g : Matrix n n F) = Matrix.transvection i j c}
  have hD0 : ∀ k, D k ≠ 0 := fun k hk =>
    one_ne_zero (hD ▸ Finset.prod_eq_zero (Finset.mem_univ k) hk)
  let u : n → Fˣ := fun k => Units.mk0 (D k) (hD0 k)
  let φ : (n → Fˣ) →* GL n F :=
    (Units.map (diagonalRingHom n F).toMonoidHom).comp MulEquiv.piUnits.symm.toMonoidHom
  have hφ : ∀ w, (φ w : Matrix n n F) = diagonal fun k => ((w k : Fˣ) : F) := fun w => rfl
  have hgu : g = φ u := by
    ext : 1
    rw [hg, hφ]
    rfl
  rw [hgu]
  change u ∈ (Subgroup.closure S).comap φ
  rcases isEmpty_or_nonempty n with hn | ⟨⟨i0⟩⟩
  · have : u = 1 := funext fun k => (IsEmpty.false k).elim
    rw [this]
    exact Subgroup.one_mem _
  have hprod : ∏ j, u j = 1 := Units.ext (by simpa [u] using hD)
  have hdec : u = ∏ j, (Pi.mulSingle j (u j) * Pi.mulSingle i0 (u j)⁻¹) := by
    have h := map_prod (MonoidHom.mulSingle (fun _ => Fˣ) i0) (fun x => (u x)⁻¹) Finset.univ
    simp only [MonoidHom.mulSingle_apply] at h
    rw [Finset.prod_mul_distrib, Finset.univ_prod_mulSingle, ← h, Finset.prod_inv_distrib, hprod,
      inv_one, Pi.mulSingle_one, mul_one]
  rw [hdec]
  refine Subgroup.prod_mem _ fun j _ => ?_
  by_cases hj : j = i0
  · subst hj
    rw [← Pi.mulSingle_mul, mul_inv_cancel, Pi.mulSingle_one]
    exact Subgroup.one_mem _
  · refine diagonal_pair_mem_closure hj (hD0 j) _ ?_
    rw [hφ]
    congr 1
    funext k
    by_cases hkj : k = j
    · subst hkj
      simp [hj, u]
    · by_cases hki : k = i0
      · subst hki
        simp [hkj, u]
      · simp [hkj, hki]

/-- **Generation of the special linear group by elementary transvections.** Let $F$ be a field and
$n$ a finite index set. The special linear group $\mathrm{SL}_n(F)$, as a subgroup of
$\mathrm{GL}_n(F)$, is the subgroup generated by the elementary transvections
$1 + c\, e_{ij}$, $i \neq j$, $c \in F^\times$: every matrix of determinant $1$ is a product of
elementary transvections. The proof writes a matrix as transvections times a diagonal matrix times
transvections (`Matrix.diagonal_transvection_induction`) and uses
`diagonal_mem_closure_transvections` for the diagonal factor.

Source: K. Conrad, *Simplicity of $\mathrm{PSL}_n(F)$*, expository note,
<https://kconrad.math.uconn.edu/blurbs/grouptheory/PSLnsimple.pdf>,
§4, Theorem 4.5, p. 8 ("the matrices $I_n + \lambda E_{ij}$ with $i \neq j$ and
$\lambda \in F^\times$ generate $\mathrm{SL}_n(F)$"), stated there for $n \geq 2$; the Lean
statement also covers index sets with at most one element, where both subgroups are trivial. -/
theorem range_toGL_eq_closure_transvections :
    (SpecialLinearGroup.toGL : SpecialLinearGroup n F →* GL n F).range =
      Subgroup.closure
        {g : GL n F | ∃ i j : n, ∃ c : F, i ≠ j ∧ c ≠ 0 ∧
          (g : Matrix n n F) = Matrix.transvection i j c} := by
  apply le_antisymm
  · rintro _ ⟨A, rfl⟩
    obtain ⟨-, g, hg, hgA⟩ := diagonal_transvection_induction
      (fun M => M.det = 1 ∧ ∃ g ∈ Subgroup.closure
        {g : GL n F | ∃ i j : n, ∃ c : F, i ≠ j ∧ c ≠ 0 ∧
          (g : Matrix n n F) = Matrix.transvection i j c}, (g : Matrix n n F) = M)
      (A : Matrix n n F)
      (fun D hD => by
        rw [SpecialLinearGroup.det_coe] at hD
        refine ⟨hD, mkOfDetNeZero (diagonal D) (by rw [hD]; exact one_ne_zero), ?_, rfl⟩
        refine diagonal_mem_closure_transvections ?_ _ rfl
        rw [← det_diagonal, hD])
      (fun t => ⟨t.det, GeneralLinearGroup.transvection t.i t.j t.hij t.c,
        transvection_mem_closure _ _, rfl⟩)
      (fun A B ⟨hA, gA, hgA, hA'⟩ ⟨hB, gB, hgB, hB'⟩ => ⟨by rw [det_mul, hA, hB, one_mul],
        gA * gB, mul_mem hgA hgB, by rw [Units.val_mul, hA', hB']⟩)
    have : g = SpecialLinearGroup.toGL A := Units.ext hgA
    rw [← this]
    exact hg
  · rw [Subgroup.closure_le]
    rintro g ⟨i, j, c, hij, -, hg⟩
    refine ⟨⟨g, by rw [hg, det_transvection_of_ne _ _ hij]⟩, Units.ext rfl⟩


/-- Every transvection $1 + c\, e_{ij}$, $i \neq j$, of $\mathrm{GL}_n(F)$, for a linearly ordered
finite index set $n$, lies in the subgroup generated by the conjugates $g u g^{-1}$ of the upper
unitriangular matrices $u$: for $i < j$ it is upper unitriangular, and for $i > j$ it is the
conjugate of $1 + c\, e_{ji}$ by the permutation matrix of the transposition of $i$ and $j$. -/
theorem transvection_mem_closure_conj_upperTriangular [LinearOrder n] {i j : n} (hij : i ≠ j)
    (c : F) (g : GL n F) (hg : (g : Matrix n n F) = Matrix.transvection i j c) :
    g ∈ Subgroup.closure {x : GL n F | ∃ g u : GL n F, (u : Matrix n n F).IsUpperTriangular ∧
      (∀ k, (u : Matrix n n F) k k = 1) ∧ x = g * u * g⁻¹} := by
  have hupper : ∀ {a b : n}, a < b → ∀ c : F,
      (Matrix.transvection a b c).IsUpperTriangular ∧ ∀ k, Matrix.transvection a b c k k = 1 := by
    intro a b hab c
    refine ⟨fun x y hyx => ?_, fun k => ?_⟩
    · have hxy : x ≠ y := (ne_of_lt hyx).symm
      have : ¬(a = x ∧ b = y) := by
        rintro ⟨rfl, rfl⟩
        exact lt_asymm hab hyx
      simp [Matrix.transvection, hxy, this]
    · have : ¬(a = k ∧ b = k) := by
        rintro ⟨rfl, h⟩
        exact (ne_of_lt hab) h.symm
      simp [Matrix.transvection, this]
  rcases lt_or_gt_of_ne hij with h | h
  · obtain ⟨hu, hd⟩ := hupper h c
    exact Subgroup.subset_closure ⟨1, g, hg ▸ hu, hg ▸ hd, by simp⟩
  · obtain ⟨hu, hd⟩ := hupper h c
    set σ := Equiv.swap i j
    set P : Matrix n n F := σ.toPEquiv.toMatrix
    have hσσ : (σ ∘ σ : n → n) = id := funext fun x => Equiv.swap_apply_self i j x
    have hP1 : P = (1 : Matrix n n F).submatrix σ id := PEquiv.toMatrix_toPEquiv_eq σ
    have hPP : P * P = 1 := by
      rw [PEquiv.toMatrix_toPEquiv_mul, hP1, Matrix.submatrix_submatrix, hσσ, Function.comp_id,
        Matrix.submatrix_id_id]
    let w : GL n F := ⟨P, P, hPP, hPP⟩
    refine Subgroup.subset_closure ⟨w, GeneralLinearGroup.transvection j i hij.symm c, hu, hd, ?_⟩
    ext : 1
    change (g : Matrix n n F) = P * Matrix.transvection j i c * P
    rw [PEquiv.toMatrix_toPEquiv_mul, PEquiv.mul_toMatrix_toPEquiv, Matrix.submatrix_submatrix,
      Function.comp_id, Function.id_comp, hg, Matrix.transvection, Matrix.transvection,
      Matrix.submatrix_add, Pi.add_apply, Pi.add_apply, Equiv.symm_swap, Matrix.submatrix_one_equiv,
      Matrix.submatrix_single_equiv, Equiv.symm_swap, Equiv.swap_apply_right,
      Equiv.swap_apply_left]

/-- **$\mathrm{SL}_n(F)$ is generated by the conjugates of the upper unitriangular matrices.** Let
$F$ be a field and $n$ a linearly ordered finite index set. The special linear group
$\mathrm{SL}_n(F)$, as a subgroup of $\mathrm{GL}_n(F)$, is the subgroup generated by the conjugates
$g u g^{-1}$, $g \in \mathrm{GL}_n(F)$, of the upper unitriangular matrices $u$ (upper triangular,
`Matrix.IsUpperTriangular`, with $1$ on the diagonal).

Source: T. Wedhorn, *The local Langlands correspondence for GL(n) over p-adic fields*,
arXiv:math/0011210 (version 2),
proof of (2.1.18), pp. 19–20 ("the subgroup of $\mathrm{GL}_n(K)$ which is
generated by all conjugates of $U$ and this is nothing but $\mathrm{SL}_n(K)$"), for $K$ a
non-archimedean local field; the Lean statement is this algebraic step, over any field. -/
theorem range_toGL_eq_closure_conj_upperTriangular [LinearOrder n] :
    (SpecialLinearGroup.toGL : SpecialLinearGroup n F →* GL n F).range =
      Subgroup.closure {x : GL n F | ∃ g u : GL n F, (u : Matrix n n F).IsUpperTriangular ∧
        (∀ k, (u : Matrix n n F) k k = 1) ∧ x = g * u * g⁻¹} := by
  apply le_antisymm
  · rw [range_toGL_eq_closure_transvections, Subgroup.closure_le]
    rintro g ⟨i, j, c, hij, -, hg⟩
    exact transvection_mem_closure_conj_upperTriangular hij c g hg
  · rw [Subgroup.closure_le]
    rintro _ ⟨g, u, hu, hd, rfl⟩
    refine ⟨⟨((g * u * g⁻¹ : GL n F) : Matrix n n F), ?_⟩, Units.ext rfl⟩
    rw [Units.val_mul, Units.val_mul, det_mul, det_mul, mul_right_comm, ← det_mul,
      ← Units.val_mul, mul_inv_cancel, Units.val_one, det_one, one_mul,
      det_of_isUpperTriangular hu]
    simp [hd]

/-- **Homomorphisms trivial on the upper unitriangular matrices factor through the determinant.**
Let $F$ be a field, $n$ a nonempty linearly ordered finite index set, $A$ a commutative group and
$\varphi \colon \mathrm{GL}_n(F) \to A$ a homomorphism with $\varphi(u) = 1$ for every upper
unitriangular $u$. Then there is a unique homomorphism $\chi \colon F^\times \to A$ with
$\varphi = \chi \circ \det$. Indeed $\varphi$ is trivial on the conjugates of the upper
unitriangular matrices, hence on $\mathrm{SL}_n(F)$, the kernel of the determinant, which is
surjective.

Source: T. Wedhorn, *The local Langlands correspondence for GL(n) over p-adic fields*,
arXiv:math/0011210 (version 2),
(2.1.18) and its proof, pp. 19–20 (a one-dimensional smooth representation of
$\mathrm{GL}_n(K)$ is trivial on the conjugates of $U$, hence on $\mathrm{SL}_n(K)$, and is of the
form $\chi \circ \det$). Wedhorn treats smooth complex representations over a non-archimedean
local field; the Lean statement is the algebraic step: it assumes triviality on the upper
unitriangular matrices, works over any field, and gives uniqueness for any commutative target. -/
theorem exists_unique_eq_comp_det [LinearOrder n] [Nonempty n] {A : Type*} [CommGroup A]
    (φ : GL n F →* A) (hφ : ∀ u : GL n F, (u : Matrix n n F).IsUpperTriangular →
      (∀ k, (u : Matrix n n F) k k = 1) → φ u = 1) :
    ∃! χ : Fˣ →* A, φ = χ.comp GeneralLinearGroup.det := by
  classical
  have hSL : ∀ g : GL n F, (g : Matrix n n F).det = 1 → φ g = 1 := by
    intro g hg
    have hmem : g ∈ (SpecialLinearGroup.toGL : SpecialLinearGroup n F →* GL n F).range :=
      ⟨⟨g, hg⟩, Units.ext rfl⟩
    rw [range_toGL_eq_closure_conj_upperTriangular] at hmem
    refine Subgroup.closure_induction (p := fun x _ => φ x = 1) ?_ (map_one φ)
      (fun x y _ _ hx hy => by rw [map_mul, hx, hy, one_mul])
      (fun x _ hx => by rw [map_inv, hx, inv_one]) hmem
    rintro _ ⟨h, u, hu, hd, rfl⟩
    rw [map_mul, map_mul, hφ u hu hd, mul_one, map_inv, mul_inv_cancel]
  have hker : GeneralLinearGroup.det.ker ≤ φ.ker := by
    rw [← SpecialLinearGroup.range_toGL_eq_ker_det]
    rintro _ ⟨A, rfl⟩
    exact hSL _ (SpecialLinearGroup.det_coe A)
  set χ0 := GeneralLinearGroup.det.liftOfSurjective GeneralLinearGroup.det_surjective ⟨φ, hker⟩
  have hχ0 : χ0.comp GeneralLinearGroup.det = φ :=
    MonoidHom.liftOfRightInverse_comp _ _ _ ⟨φ, hker⟩
  refine ⟨χ0, hχ0.symm, fun χ hχ => MonoidHom.ext fun t => ?_⟩
  obtain ⟨g, rfl⟩ := GeneralLinearGroup.det_surjective (n := n) t
  rw [← MonoidHom.comp_apply, ← MonoidHom.comp_apply, ← hχ, hχ0]

end Matrix.GeneralLinearGroup

end

/-!
# Subgroups of `GL₂` with cyclic projective image lie in a Cartan subgroup

* `Matrix.GeneralLinearGroup.exists_isCartanSubgroup_le_of_isCyclic`: a subgroup `G` of `GL₂(F)`
  whose order is nonzero in `F` and whose image in `PGL₂(F) = GL₂(F) ⧸ Z` is cyclic lies in a
  Cartan subgroup; `exists_isCartanSubgroup_le_of_isCyclic_zmod` is the case `F = 𝔽_ℓ` with the
  order of `G` prime to `ℓ`.

Proof: let `g ∈ G` map to a generator of the image, so every `h ∈ G` is
`g ^ k` times a scalar. If `g` is a scalar, `G` lies in the diagonal Cartan subgroup. Otherwise
`F[g] = F + F g` is a Cartan subalgebra (`isCartanSubalgebra_adjoin`): commutative of dimension
`2` by Cayley–Hamilton, and separable since `tr(g)² - 4 det(g) ≠ 0`: when `2 ≠ 0` this uses
`(c + m)^n = c^n + n c^(n-1) m` for `m² = 0` and `n`, the order of `g`, nonzero in `F`; when
`2 = 0`, `n` is odd and `g²` would be a scalar.

## References

* A. V. Sutherland, *Computing images of Galois representations attached to elliptic curves*,
  Forum Math. Sigma 4 (2016), e4: Proposition 3.1 (1), p. 10.
* P. Deligne and J.-P. Serre, *Formes modulaires de poids 1*, Ann. Sci. École Norm. Sup. (4) 7
  (1974), 507–530: démonstration of Proposition 7.2, p. 524, condition (b).
-/

@[expose] public section

set_option autoImplicit false

open Matrix

variable {F : Type*} [Field F]

namespace Matrix.GeneralLinearGroup

/-- **Powers of a scalar plus a square-zero matrix.** If $m \in M_2(F)$ has $m^2 = 0$, then
$(c + m)^{k+1} = c^{k+1} + (k+1) c^k m$ for every $c \in F$ and $k \in \mathbb{N}$. -/
theorem add_pow_succ_of_mul_self_eq_zero (c : F) {m : Matrix (Fin 2) (Fin 2) F} (hm : m * m = 0)
    (k : ℕ) :
    (algebraMap F _ c + m) ^ (k + 1) = algebraMap F _ (c ^ (k + 1)) + ((k + 1) * c ^ k) • m := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ, ih]
    simp only [Algebra.algebraMap_eq_smul_one, add_mul, mul_add, smul_mul_assoc, mul_smul_comm,
      one_mul, mul_one, hm, smul_zero, add_zero]
    push_cast
    module


/-- **No unipotent part in order prime to the characteristic.** Let $g \in \mathrm{GL}_2(F)$ have
order $n$ with $n \neq 0$ in $F$. If $(g - c)^2 = 0$ for some $c \in F$, then $g = c$. -/
theorem eq_zero_of_sub_mul_self_eq_zero {g : GL (Fin 2) F} (hg : ((orderOf g : ℕ) : F) ≠ 0)
    (c : F) (hm : ((g : Matrix (Fin 2) (Fin 2) F) - algebraMap F _ c) *
      ((g : Matrix (Fin 2) (Fin 2) F) - algebraMap F _ c) = 0) :
    (g : Matrix (Fin 2) (Fin 2) F) - algebraMap F _ c = 0 := by
  set m := (g : Matrix (Fin 2) (Fin 2) F) - algebraMap F _ c with hmdef
  have hgm : (g : Matrix (Fin 2) (Fin 2) F) = algebraMap F _ c + m := by rw [hmdef]; abel
  have hn0 : orderOf g ≠ 0 := fun h => hg (by rw [h, Nat.cast_zero])
  obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hn0
  have hpow : algebraMap F _ (c ^ (k + 1)) + ((k + 1) * c ^ k) • m = 1 := by
    rw [← add_pow_succ_of_mul_self_eq_zero c hm, ← hgm, ← Units.val_pow_eq_pow_val,
      show k + 1 = orderOf g from hk.symm, pow_orderOf_eq_one, Units.val_one]
  have hc : c ≠ 0 := by
    rintro rfl
    have hgg : (g : Matrix (Fin 2) (Fin 2) F) * g = 0 := by
      rw [hgm, map_zero, zero_add]; exact hm
    have : ((g * g : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) = 0 := by
      rw [Units.val_mul]; exact hgg
    exact (g * g).ne_zero this
  have hk' : ((k : F) + 1) * c ^ k ≠ 0 := by
    refine mul_ne_zero ?_ (pow_ne_zero _ hc)
    rw [hk] at hg
    exact_mod_cast hg
  have hm' : m = algebraMap F _ ((((k : F) + 1) * c ^ k)⁻¹ * (1 - c ^ (k + 1))) := by
    rw [map_mul, map_sub, map_one, ← hpow, add_sub_cancel_left, ← Algebra.smul_def, smul_smul,
      inv_mul_cancel₀ hk', one_smul]
  rw [hm', ← map_mul] at hm
  rw [hm', (map_eq_zero_iff _ (algebraMap F (Matrix (Fin 2) (Fin 2) F)).injective).2]
  exact mul_self_eq_zero.1 ((map_eq_zero_iff _ (algebraMap F _).injective).1 hm)


/-- **The algebra generated by a $2 \times 2$ matrix.** The subalgebra of $M_2(F)$ generated by $g$
lies in the span of $1$ and $g$, by Cayley–Hamilton. -/
theorem toSubmodule_adjoin_le_span (g : Matrix (Fin 2) (Fin 2) F) :
    Subalgebra.toSubmodule (Algebra.adjoin F {g}) ≤ Submodule.span F {1, g} := by
  intro x hx
  have hCH := mul_self_eq_trace_smul_sub_det_smul g
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    rw [Set.mem_singleton_iff.1 hx]
    exact Submodule.subset_span (by simp)
  | algebraMap r =>
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ r (Submodule.subset_span (by simp))
  | add x y _ _ hx hy => exact add_mem hx hy
  | mul x y _ _ hx hy =>
    rw [Submodule.mem_span_pair] at hx hy ⊢
    obtain ⟨a, b, rfl⟩ := hx
    obtain ⟨a', b', rfl⟩ := hy
    refine ⟨a * a' - b * b' * g.det, a * b' + b * a' + b * b' * g.trace, ?_⟩
    simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, one_mul, mul_one, hCH]
    module

/-- **Inverses lie in the generated algebra.** For $g \in \mathrm{GL}_2(F)$, the inverse $g^{-1}$
lies in the subalgebra of $M_2(F)$ generated by $g$:
$g^{-1} = \det(g)^{-1} (\operatorname{tr}(g) - g)$. -/
theorem inv_mem_adjoin (g : GL (Fin 2) F) :
    ((g⁻¹ : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) ∈
      Algebra.adjoin F {(g : Matrix (Fin 2) (Fin 2) F)} := by
  have hdet : (g : Matrix (Fin 2) (Fin 2) F).det ≠ 0 :=
    ((Matrix.isUnit_iff_isUnit_det _).1 g.isUnit).ne_zero
  have hCH := mul_self_eq_trace_smul_sub_det_smul (g : Matrix (Fin 2) (Fin 2) F)
  have hinv : ((g⁻¹ : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) =
      (g : Matrix (Fin 2) (Fin 2) F).det⁻¹ •
        ((g : Matrix (Fin 2) (Fin 2) F).trace • 1 - (g : Matrix (Fin 2) (Fin 2) F)) := by
    apply Units.inv_eq_of_mul_eq_one_right
    rw [mul_smul_comm, mul_sub, mul_smul_comm, mul_one, hCH, sub_sub_cancel, smul_smul,
      inv_mul_cancel₀ hdet, one_smul]
  rw [hinv]
  refine Subalgebra.smul_mem _ (Subalgebra.sub_mem _ ?_ (Algebra.subset_adjoin rfl)) _
  exact Subalgebra.smul_mem _ (Subalgebra.one_mem _) _

/-- **The algebra generated by a non-scalar element of order prime to the characteristic is
Cartan.** Let $g \in \mathrm{GL}_2(F)$ be a non-scalar matrix whose order $n$ is nonzero in $F$.
Then the subalgebra $F[g]$ of $M_2(F)$ generated by $g$ is a Cartan subalgebra: it is commutative
of dimension $2$, and $\operatorname{tr}(g)^2 - 4 \det(g) \neq 0$, so that it is separable over $F$.
Otherwise, in characteristic other than $2$, $(g - \operatorname{tr}(g)/2)^2 = 0$ would force $g$ to
be scalar, and in characteristic $2$, $g^2$ would be a scalar, so that $g = g^n g^{-2k}$ would be
scalar for the order $n = 2k + 1$ of $g$, which is odd.

Source: P. Deligne and J.-P. Serre, *Formes modulaires de poids 1*,
Ann. Sci. École Norm. Sup. (4) 7 (1974), 507–530,
démonstration of Proposition 7.2, p. 524, condition (b). -/
theorem isCartanSubalgebra_adjoin {g : GL (Fin 2) F} (hg : ((orderOf g : ℕ) : F) ≠ 0)
    (hns : ∀ c : F, (g : Matrix (Fin 2) (Fin 2) F) ≠ algebraMap F _ c) :
    Matrix.IsCartanSubalgebra (Algebra.adjoin F {(g : Matrix (Fin 2) (Fin 2) F)}) := by
  set A := Algebra.adjoin F {(g : Matrix (Fin 2) (Fin 2) F)}
  have hc : ∀ x ∈ A, ∀ y ∈ A, x * y = y * x := fun x hx y hy =>
    (Algebra.commute_of_mem_adjoin_of_forall_mem_commute hy fun z hz =>
      (Algebra.commute_of_mem_adjoin_of_forall_mem_commute hx fun w hw => by
        rw [Set.mem_singleton_iff.1 hz, Set.mem_singleton_iff.1 hw]
        exact Commute.refl _).symm).eq
  have hspan := toSubmodule_adjoin_le_span (g : Matrix (Fin 2) (Fin 2) F)
  have hr : Module.finrank F A = 2 := by
    have hle : Module.finrank F A ≤ 2 := by
      rw [← Subalgebra.finrank_toSubmodule]
      refine (Submodule.finrank_mono hspan).trans ?_
      have := finrank_range_le_card (R := F) ![(1 : Matrix (Fin 2) (Fin 2) F), g]
      rw [Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty,
        Set.singleton_union, Fintype.card_fin] at this
      exact this
    have h0 : 0 < Module.finrank F A := Module.finrank_pos
    have h1 : Module.finrank F A ≠ 1 := by
      intro h1
      have hbot := Subalgebra.finrank_eq_one_iff.1 h1
      have hgA : (g : Matrix (Fin 2) (Fin 2) F) ∈ A := Algebra.subset_adjoin rfl
      rw [hbot, Algebra.mem_bot] at hgA
      obtain ⟨c, hc⟩ := hgA
      exact hns c hc.symm
    omega
  refine isCartanSubalgebra_of_trace_sq_sub_ne_zero hc hr (Algebra.subset_adjoin rfl) ?_
  set t := (g : Matrix (Fin 2) (Fin 2) F).trace
  set d := (g : Matrix (Fin 2) (Fin 2) F).det
  have hCH : (g : Matrix (Fin 2) (Fin 2) F) * g = t • (g : Matrix (Fin 2) (Fin 2) F) - d • 1 :=
    mul_self_eq_trace_smul_sub_det_smul _
  intro hΔ
  by_cases h2 : (2 : F) = 0
  · -- characteristic `2`: `t = 0`, so `g²` is the scalar `-d`, and the order of `g` is odd
    have ht : t = 0 := by
      have h4 : (4 : F) = 2 * 2 := by norm_num
      rw [h4, h2, zero_mul, zero_mul, sub_zero] at hΔ
      exact pow_eq_zero_iff (two_ne_zero) |>.1 hΔ
    have hg2 : (g : Matrix (Fin 2) (Fin 2) F) * g = algebraMap F _ (-d) := by
      rw [hCH, ht, zero_smul, zero_sub, map_neg, Algebra.algebraMap_eq_smul_one]
    have hodd : Odd (orderOf g) := by
      rw [← Nat.not_even_iff_odd]
      rintro ⟨m, hm⟩
      apply hg
      rw [hm, ← two_mul, Nat.cast_mul, Nat.cast_ofNat, h2, zero_mul]
    obtain ⟨k, hk⟩ := hodd
    have hpow : algebraMap F (Matrix (Fin 2) (Fin 2) F) ((-d) ^ k) * g = 1 := by
      have h1 : (g : Matrix (Fin 2) (Fin 2) F) ^ (orderOf g) = 1 := by
        rw [← Units.val_pow_eq_pow_val, pow_orderOf_eq_one, Units.val_one]
      rw [hk, pow_succ, pow_mul, sq, hg2, ← map_pow] at h1
      exact h1
    have he : (-d) ^ k ≠ 0 := by
      intro he
      rw [he, map_zero, zero_mul] at hpow
      exact zero_ne_one hpow
    apply hns ((-d) ^ k)⁻¹
    calc (g : Matrix (Fin 2) (Fin 2) F)
        = algebraMap F _ ((-d) ^ k)⁻¹ * (algebraMap F _ ((-d) ^ k) * g) := by
          rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ he, map_one, one_mul]
      _ = algebraMap F _ ((-d) ^ k)⁻¹ := by rw [hpow, mul_one]
  · -- characteristic not `2`: `(g - t / 2)² = (t² - 4 d) / 4 = 0`
    have hc2 : t = 2 * (t / 2) := by field_simp
    have hd : d = t / 2 * (t / 2) := by
      field_simp
      linear_combination -hΔ
    have hm : ((g : Matrix (Fin 2) (Fin 2) F) - algebraMap F _ (t / 2)) *
        ((g : Matrix (Fin 2) (Fin 2) F) - algebraMap F _ (t / 2)) = 0 := by
      rw [Algebra.algebraMap_eq_smul_one]
      simp only [sub_mul, mul_sub, smul_mul_assoc, mul_smul_comm, one_mul, mul_one]
      rw [hCH]
      rw [hd]
      nth_rewrite 1 [hc2]
      module
    exact hns (t / 2) (sub_eq_zero.1 (eq_zero_of_sub_mul_self_eq_zero hg (t / 2) hm))


/-- The scalar matrix of $z \in F^\times$ is the image of $z$ in $M_2(F)$. -/
theorem coe_scalar_eq_algebraMap (z : Fˣ) :
    ((scalar (Fin 2) z : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) = algebraMap F _ (z : F) := by
  simp [Matrix.algebraMap_eq_diagonal]

/-- **Subgroups with cyclic projective image lie in a Cartan subgroup.** Let $G$ be a subgroup of
$\mathrm{GL}_2(F)$ whose order is nonzero in $F$ (so $G$ is finite of order prime to the
characteristic), and whose image in
$\mathrm{PGL}_2(F) = \mathrm{GL}_2(F)/Z$, $Z$ the center, is cyclic. Then $G$ is contained in a
Cartan subgroup of $\mathrm{GL}_2(F)$.

Source: A. V. Sutherland, *Computing images of Galois representations attached to elliptic
curves*, Forum Math. Sigma 4 (2016), e4, Proposition 3.1 (1), p. 10
("H is cyclic and G lies in a Cartan group"), for odd $\ell$ and $G$ with no element of order
$\ell$.

Source: P. Deligne and J.-P. Serre, *Formes modulaires de poids 1*,
Ann. Sci. École Norm. Sup. (4) 7 (1974), 507–530,
démonstration of Proposition 7.2, p. 524, condition (b). -/
theorem exists_isCartanSubgroup_le_of_isCyclic {G : Subgroup (GL (Fin 2) F)}
    (hG : ((Nat.card G : ℕ) : F) ≠ 0)
    (hcyc : IsCyclic (G.map (QuotientGroup.mk' (Subgroup.center (GL (Fin 2) F))))) :
    ∃ T : Subgroup (GL (Fin 2) F), IsCartanSubgroup T ∧ G ≤ T := by
  obtain ⟨γ, hγ⟩ := hcyc.exists_generator
  obtain ⟨g, hgG, hgγ⟩ := Subgroup.mem_map.1 γ.2
  -- every element of `G` is a scalar times a power of `g`
  have hrep : ∀ h ∈ G, ∃ k : ℤ, ∃ z : Fˣ, h = g ^ k * scalar (Fin 2) z := by
    intro h hh
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1
      (hγ ⟨QuotientGroup.mk' _ h, Subgroup.mem_map_of_mem _ hh⟩)
    have hk' : (QuotientGroup.mk' (Subgroup.center (GL (Fin 2) F)) (g ^ k)) =
        QuotientGroup.mk' _ h := by
      rw [map_zpow, hgγ]
      exact congrArg Subtype.val hk
    rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq,
      center_eq_range_scalar] at hk'
    obtain ⟨z, hz⟩ := hk'
    exact ⟨k, z, by rw [hz, mul_inv_cancel_left]⟩
  have hfin : Finite G := Nat.finite_of_card_ne_zero (fun h => hG (by rw [h, Nat.cast_zero]))
  have hord : ((orderOf g : ℕ) : F) ≠ 0 := by
    obtain ⟨t, ht⟩ := Subgroup.orderOf_dvd_natCard G hgG
    intro h0
    apply hG
    rw [ht, Nat.cast_mul, h0, zero_mul]
  by_cases hsc : ∃ c : F, (g : Matrix (Fin 2) (Fin 2) F) = algebraMap F _ c
  · -- `G` consists of scalars
    obtain ⟨c, hc⟩ := hsc
    refine ⟨splitCartan F, ⟨diagonalSubalgebra F, isCartanSubalgebra_diagonalSubalgebra F,
      splitCartan_eq_units F⟩, fun h hh => ?_⟩
    obtain ⟨k, z, rfl⟩ := hrep h hh
    refine mul_mem (zpow_mem ?_ k) ?_
    · rw [mem_splitCartan, hc]
      simp [Matrix.algebraMap_matrix_apply]
    · rw [mem_splitCartan, coe_scalar_eq_algebraMap]
      simp [Matrix.algebraMap_matrix_apply]
  · push Not at hsc
    refine ⟨(Algebra.adjoin F {(g : Matrix (Fin 2) (Fin 2) F)}).toSubsemiring.toSubmonoid.units,
      ⟨_, isCartanSubalgebra_adjoin hord hsc, rfl⟩, fun h hh => ?_⟩
    obtain ⟨k, z, rfl⟩ := hrep h hh
    refine mul_mem (zpow_mem ((Submonoid.mem_units_iff _ _).2 ⟨Algebra.subset_adjoin rfl,
      inv_mem_adjoin g⟩) k) ((Submonoid.mem_units_iff _ _).2 ⟨?_, ?_⟩)
    · rw [coe_scalar_eq_algebraMap]; exact Subalgebra.algebraMap_mem _ _
    · rw [← map_inv, coe_scalar_eq_algebraMap]; exact Subalgebra.algebraMap_mem _ _

/-- **Subgroups of $\mathrm{GL}_2(\mathbb{F}_\ell)$ with cyclic projective image lie in a Cartan
subgroup.** Let $\ell$ be a prime and $G$ a subgroup of $\mathrm{GL}_2(\mathbb{F}_\ell)$ whose order
is prime to $\ell$ and whose image in $\mathrm{PGL}_2(\mathbb{F}_\ell)$ is cyclic. Then $G$ is
contained in a Cartan subgroup of $\mathrm{GL}_2(\mathbb{F}_\ell)$.

Source: A. V. Sutherland, *Computing images of Galois representations attached to elliptic
curves*, Forum Math. Sigma 4 (2016), e4, Proposition 3.1 (1), p. 10.

Source: P. Deligne and J.-P. Serre, *Formes modulaires de poids 1*,
Ann. Sci. École Norm. Sup. (4) 7 (1974), 507–530,
démonstration of Proposition 7.2, p. 524, condition (b). -/
theorem exists_isCartanSubgroup_le_of_isCyclic_zmod {ℓ : ℕ} [Fact ℓ.Prime]
    {G : Subgroup (GL (Fin 2) (ZMod ℓ))} (hG : Nat.Coprime (Nat.card G) ℓ)
    (hcyc : IsCyclic (G.map (QuotientGroup.mk' (Subgroup.center (GL (Fin 2) (ZMod ℓ)))))) :
    ∃ T : Subgroup (GL (Fin 2) (ZMod ℓ)), IsCartanSubgroup T ∧ G ≤ T := by
  refine exists_isCartanSubgroup_le_of_isCyclic (fun h => ?_) hcyc
  rw [ZMod.natCast_eq_zero_iff] at h
  have := Nat.Coprime.coprime_dvd_left h hG
  rw [Nat.coprime_self] at this
  exact (Fact.out : ℓ.Prime).one_lt.ne' this

end Matrix.GeneralLinearGroup

end

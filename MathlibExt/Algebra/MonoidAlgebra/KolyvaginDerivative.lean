module

public import Mathlib.Algebra.MonoidAlgebra.Basic
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.Tactic.Abel
import Mathlib.Tactic.Ring

/-!
# Kolyvagin's derivative operator

Let `G` be a cyclic group of order `ℓ + 1` with generator `σ`, and `Tr = ∑_{g ∈ G} g` in the group
ring `ℤ[G]`. Kolyvagin's operator `D⁰ = ∑_{i=1}^{ℓ} i σ^i` satisfies `(σ - 1) D⁰ = ℓ + 1 - Tr`, and
the solutions `D` of `(σ - 1) D = ℓ + 1 - Tr` are exactly `D⁰ + k Tr`, `k ∈ ℤ`
(`MonoidAlgebra.of_sub_one_mul_sum_smul_of_pow_and_iff`). This is (3.5) of B. H. Gross,
*Kolyvagin's work on modular elliptic curves*, 1991, pp. 239–240.

## Proof

Abel summation gives `∑_{i=1}^{ℓ} i (σ^{i+1} - σ^i) = ℓ σ^{ℓ+1} - ∑_{i=1}^{ℓ} σ^i`, and
`σ^{ℓ+1} = 1`, `Tr = ∑_{i=0}^{ℓ} σ^i`. An element `x` with `σ x = x` has `x(σ⁻¹ g) = x(g)` for all
`g`, so its coefficients are constant on `G = ⟨σ⟩` and `x = x(1) Tr`.
-/

set_option autoImplicit false

@[expose] public section

open Finset

namespace MonoidAlgebra

variable {G : Type*} [Group G] [Fintype G]

/-- Abel summation for the derivative operator. -/
private theorem sum_succ_smul_sub {A : Type*} [Ring A] (x : ℕ → A) (m : ℕ) :
    ∑ i ∈ range m, ((i + 1 : ℕ) : ℤ) • (x (i + 2) - x (i + 1)) =
      (m : ℤ) • x (m + 1) - ∑ i ∈ range m, x (i + 1) := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [sum_range_succ, ih, sum_range_succ]
    push_cast
    simp only [add_smul, one_smul, smul_sub]
    abel

/-- The trace is fixed by left multiplication by any group element. -/
private theorem of_mul_sum (σ : G) :
    of ℤ G σ * ∑ g : G, of ℤ G g = ∑ g : G, of ℤ G g := by
  rw [mul_sum]
  exact Fintype.sum_equiv (Equiv.mulLeft σ) _ _ fun g => by simp

/-- An element fixed by a generator is a multiple of the trace. -/
private theorem eq_smul_sum_of_of_mul_eq {σ : G} (hσ : ∀ g : G, g ∈ Subgroup.zpowers σ)
    {x : MonoidAlgebra ℤ G} (hx : of ℤ G σ * x = x) :
    x = x.coeff 1 • ∑ g : G, of ℤ G g := by
  have hshift : ∀ g, x.coeff (σ⁻¹ * g) = x.coeff g := fun g => by
    have := congrArg (fun y : MonoidAlgebra ℤ G => y.coeff g) hx
    simpa [of_apply, coeff_single_mul_apply] using this
  have hpow : ∀ k : ℤ, x.coeff (σ ^ k) = x.coeff 1 := by
    intro k
    induction k using Int.induction_on with
    | zero => simp
    | succ k ih =>
      rw [← ih, ← hshift (σ ^ ((k : ℤ) + 1)), ← zpow_neg_one, ← zpow_add]
      congr 2; ring
    | pred k ih =>
      rw [← ih, ← hshift (σ ^ (-(k : ℤ))), ← zpow_neg_one, ← zpow_add]
      congr 2; ring
  ext g
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp (hσ g)
  classical
  rw [hpow, coeff_smul_apply, coeff_sum, Finsupp.coe_finsetSum, Finset.sum_apply]
  simp [of_apply, coeff_single, Finsupp.single_apply]

/-- **Kolyvagin's derivative operator.** Let `G` be a finite group of order `ℓ + 1` generated by
`σ` (so cyclic, with generator `σ`), and let `Tr = ∑_{g ∈ G} g` in the group ring `ℤ[G]`. Then:

1. the element `D⁰ = ∑_{i=1}^{ℓ} i σ^i` (written `∑_{i < ℓ} (i + 1) σ^{i+1}`) satisfies
   `(σ - 1) D⁰ = ℓ + 1 - Tr`;
2. an element `D ∈ ℤ[G]` satisfies `(σ - 1) D = ℓ + 1 - Tr` if and only if `D = D⁰ + k Tr` for some
   `k ∈ ℤ`.

The source takes `ℓ ≥ 1` (a prime); this is not needed.

Source: B. H. Gross, *Kolyvagin's work on modular elliptic curves*, in *L-functions and
arithmetic* (Durham, 1989), London Math. Soc. Lecture Note Ser. 153, Cambridge Univ. Press, 1991,
235–256, (3.5) and the text around it, pp. 239–240 ("let $D_\ell$ be a solution of
$(\sigma_\ell - 1) \cdot D_\ell = \ell + 1 - \mathrm{Tr}_\ell$ in $\mathbb{Z}[G_\ell]$. Then
$D_\ell$ is well-defined up to addition of elements in the subgroup
$\mathbb{Z} \cdot \mathrm{Tr}_\ell$ (Kolyvagin uses the solution
$D_\ell^0 = \sum_{i=1}^{\ell} i \cdot \sigma_\ell^i$"); the proof is written out here. -/
theorem of_sub_one_mul_sum_smul_of_pow_and_iff {ℓ : ℕ} (σ : G)
    (hσ : ∀ g : G, g ∈ Subgroup.zpowers σ) (hcard : Fintype.card G = ℓ + 1) :
    (of ℤ G σ - 1) * ∑ i ∈ range ℓ, ((i + 1 : ℕ) : ℤ) • of ℤ G (σ ^ (i + 1)) =
        ((ℓ + 1 : ℕ) : MonoidAlgebra ℤ G) - ∑ g : G, of ℤ G g ∧
      ∀ D : MonoidAlgebra ℤ G,
        (of ℤ G σ - 1) * D = ((ℓ + 1 : ℕ) : MonoidAlgebra ℤ G) - ∑ g : G, of ℤ G g ↔
          ∃ k : ℤ, D = ∑ i ∈ range ℓ, ((i + 1 : ℕ) : ℤ) • of ℤ G (σ ^ (i + 1)) +
            k • ∑ g : G, of ℤ G g := by
  classical
  set D₀ := ∑ i ∈ range ℓ, ((i + 1 : ℕ) : ℤ) • of ℤ G (σ ^ (i + 1)) with hD₀
  set Tr := ∑ g : G, of ℤ G g with hTr
  have hord : orderOf σ = ℓ + 1 := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hσ, Nat.card_eq_fintype_card, hcard]
  have hTr' : Tr = ∑ i ∈ range (ℓ + 1), of ℤ G (σ ^ i) := by
    rw [hTr, ← hord, ← sum_image (f := fun g => of ℤ G g)
      (fun i hi j hj h => pow_injOn_Iio_orderOf (by simpa using hi) (by simpa using hj) h),
      IsCyclic.image_range_orderOf hσ]
  have h1 : (of ℤ G σ - 1) * D₀ = ((ℓ + 1 : ℕ) : MonoidAlgebra ℤ G) - Tr := by
    have e : (of ℤ G σ - 1) * D₀ = ∑ i ∈ range ℓ, ((i + 1 : ℕ) : ℤ) •
        (of ℤ G (σ ^ (i + 2)) - of ℤ G (σ ^ (i + 1))) := by
      rw [hD₀, mul_sum]
      refine sum_congr rfl fun i _ => ?_
      rw [mul_smul_comm, sub_mul, one_mul, ← map_mul, ← pow_succ']
    rw [e, sum_succ_smul_sub (fun i => of ℤ G (σ ^ i)), hTr', sum_range_succ']
    have : σ ^ (ℓ + 1) = 1 := hord ▸ pow_orderOf_eq_one σ
    simp only [this, pow_zero, map_one]
    push_cast
    rw [zsmul_eq_mul, mul_one, Int.cast_natCast]
    abel
  refine ⟨h1, fun D => ⟨fun hD => ?_, ?_⟩⟩
  · have hx : of ℤ G σ * (D - D₀) = D - D₀ := by
      have : (of ℤ G σ - 1) * (D - D₀) = 0 := by rw [mul_sub, hD, h1, sub_self]
      rwa [sub_mul, one_mul, sub_eq_zero] at this
    exact ⟨(D - D₀).coeff 1, by rw [← eq_smul_sum_of_of_mul_eq hσ hx]; abel⟩
  · rintro ⟨k, rfl⟩
    rw [mul_add, h1, mul_smul_comm, sub_mul, one_mul, of_mul_sum, sub_self, smul_zero,
      add_zero]

end MonoidAlgebra

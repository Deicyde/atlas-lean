module

public import MathlibExt.NumberTheory.NumberField.HeegnerIsogeny
public import Mathlib.Data.ZMod.QuotientRing
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.Tactic.LinearCombination

/-!
# Heegner points of conductor `n`: the ideal and the isogeny

Let `K` be a number field with ring of integers `𝓞 K`, let `𝒩` be an ideal of `𝓞 K` with
`𝓞 K ⧸ 𝒩` cyclic of order `N ≠ 0`, and let `n` be prime to `N`. Let `𝒪ₙ = ℤ + n 𝓞 K` be the order
of conductor `n` (a subring `R` of `𝓞 K` given by its elements) and `𝒩ₙ = 𝒩 ∩ 𝒪ₙ`.

* `NumberField.RingOfIntegers.comap_order_quotient_ringEquiv_zmod_and_mul_eq_span`:
  `𝒪ₙ ⧸ 𝒩ₙ ≃+* ℤ ⧸ N ℤ`, and `𝒩ₙ J = N 𝒪ₙ` for an ideal `J` of `𝒪ₙ`, so `𝒩ₙ` is invertible.
* `NumberField.RingOfIntegers.heegner_isogeny_conductor_isAddCyclic_ker`: for an imaginary
  quadratic `K` with complex embedding `σ`, the images `σ(𝒪ₙ)` and `σ(𝒩ₙ⁻¹)` are lattices in `ℂ`,
  `σ(𝒩ₙ⁻¹) / σ(𝒪ₙ)` is cyclic of order `N`, and the map `ℂ / σ(𝒪ₙ) → ℂ / σ(𝒩ₙ⁻¹)` is onto with
  kernel cyclic of order `N`: the cyclic `N`-isogeny that defines the Heegner point `xₙ` on
  `X₀(N)`.

The source is B. H. Gross, *Kolyvagin's work on modular elliptic curves*, in *L-functions and
arithmetic* (Durham, 1989), London Math. Soc. Lecture Note Ser. 153, Cambridge Univ. Press, 1991,
235–256, §3, p. 238; Gross states both facts without proof.

## Proof

Since `𝓞 K ⧸ 𝒩` is cyclic of order `N`, it has characteristic `N`, so `ℤ → 𝓞 K ⧸ 𝒩` is onto and
`𝒪ₙ ⧸ 𝒩ₙ ≅ 𝓞 K ⧸ 𝒩 ≅ ℤ ⧸ N ℤ`. Writing `1 = u n + v N`, every `x ∈ 𝒩` is
`u (n x) + N (v x)` with `n x, N ∈ 𝒩ₙ`, so `𝒩 = 𝒩ₙ 𝓞 K`. With `𝒩 𝒩' = N 𝓞 K` in the Dedekind
domain `𝓞 K` and `J = (N 𝒪ₙ : 𝒩ₙ)`, the elements `n 𝒩'` lie in `J`, and
`n N ∈ 𝒩ₙ 𝒩' n ⊆ 𝒩ₙ J`; with `N² ∈ 𝒩ₙ J` this gives `N ∈ 𝒩ₙ J`.

For the isogeny, `𝒩ₙ⁻¹ = 𝒪ₙ + n 𝒩⁻¹`: an `x` with `x 𝒩ₙ ⊆ 𝒪ₙ` satisfies `x 𝒩 ⊆ 𝓞 K` and
`x = u (n x) + v (N x)` with `N x ∈ 𝒪ₙ`; an element `y ∈ 𝒩⁻¹` with `n y ∈ 𝒪ₙ` lies in `𝓞 K`, as
`N y ∈ 𝓞 K`. So `y ↦ n y` induces `𝒩⁻¹ / 𝓞 K ≅ 𝒩ₙ⁻¹ / 𝒪ₙ`, and `𝒩⁻¹ / 𝓞 K ≅ 𝓞 K ⧸ 𝒩`
(`FractionalIdeal.invQuotientEquiv`). The lattices sit between `σ(n 𝓞 K)` and `σ(N⁻¹ 𝓞 K)`,
which are lattices by `NumberField.FractionalIdeal.isZLattice_complexLattice`.
-/

set_option autoImplicit false

@[expose] public section

open NumberField nonZeroDivisors

namespace NumberField.RingOfIntegers

variable {K : Type*} [Field K] [NumberField K]

/-- A ring whose additive group is cyclic of order `N` has characteristic `N`. -/
private theorem charP_of_isAddCyclic {Q : Type*} [CommRing Q] {N : ℕ}
    (hcyc : IsAddCyclic Q) (hcard : Nat.card Q = N) : CharP Q N := by
  refine ⟨fun k => ⟨fun hk => ?_, fun ⟨m, hm⟩ => ?_⟩⟩
  · rw [← hcard, ← IsAddCyclic.exponent_eq_card]
    refine AddMonoid.exponent_dvd_of_forall_nsmul_eq_zero fun x => ?_
    rw [nsmul_eq_mul, hk, zero_mul]
  · have h1 : (N : Q) = 0 := by
      have := card_nsmul_eq_zero' (x := (1 : Q))
      rwa [hcard, nsmul_eq_mul, mul_one] at this
    rw [hm, Nat.cast_mul, h1, zero_mul]

omit [NumberField K] in
/-- If `𝓞 K ⧸ 𝒩` has order `N`, then `N ∈ 𝒩`. -/
private theorem natCast_mem_of_card {𝒩 : Ideal (𝓞 K)} {N : ℕ} (hcard : Nat.card (𝓞 K ⧸ 𝒩) = N) :
    (N : 𝓞 K) ∈ 𝒩 := by
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_natCast]
  have := card_nsmul_eq_zero' (x := (1 : 𝓞 K ⧸ 𝒩))
  rwa [hcard, nsmul_eq_mul, mul_one] at this

omit [NumberField K] in
/-- Elements of the form `n y` lie in the order of conductor `n`. -/
private theorem mul_mem_order {n : ℕ} {R : Subring (𝓞 K)}
    (hR : (R : Set (𝓞 K)) = {x | ∃ (a : ℤ) (y : 𝓞 K), x = a + n * y}) (y : 𝓞 K) :
    (n : 𝓞 K) * y ∈ R := by
  rw [← SetLike.mem_coe, hR]; exact ⟨0, y, by simp⟩

omit [NumberField K] in
/-- If `𝓞 K ⧸ 𝒩` has order `N` prime to `n`, then `𝒩` is generated by `𝒩 ∩ 𝒪ₙ`. -/
private theorem le_map_comap {n N : ℕ} (hnN : n.Coprime N) {𝒩 : Ideal (𝓞 K)}
    (hNmem : (N : 𝓞 K) ∈ 𝒩) {R : Subring (𝓞 K)}
    (hR : (R : Set (𝓞 K)) = {x | ∃ (a : ℤ) (y : 𝓞 K), x = a + n * y}) :
    𝒩 ≤ (𝒩.comap R.subtype).map R.subtype := fun x hx => by
  obtain ⟨u, v, huv⟩ := Nat.isCoprime_iff_coprime.mpr hnN
  have hNI : (N : R) ∈ 𝒩.comap R.subtype := by simpa using hNmem
  have hnx : (⟨n * x, mul_mem_order hR x⟩ : R) ∈ 𝒩.comap R.subtype := by
    simpa using 𝒩.mul_mem_left (n : 𝓞 K) hx
  have e1 : x = (u : 𝓞 K) * R.subtype ⟨n * x, mul_mem_order hR x⟩ +
      R.subtype (N : R) * ((v : 𝓞 K) * x) := by
    have := congrArg (Int.cast : ℤ → 𝓞 K) huv
    push_cast at this
    simp only [Subring.subtype_apply, Subring.coe_natCast]
    linear_combination (-x) * this
  rw [e1]
  exact add_mem (Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hnx))
    (Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hNI))

/-- **The ideal of index `N` in the order of conductor `n`.** Let `K` be a number field, let `𝒩` be
an ideal of `𝓞 K` such that the additive group `𝓞 K ⧸ 𝒩` is cyclic of order `N ≠ 0`, and let `n`
be prime to `N`. Let `R = 𝒪ₙ = ℤ + n 𝓞 K` be the order of conductor `n`, given as a subring of
`𝓞 K` by its elements, and `𝒩ₙ = 𝒩 ∩ 𝒪ₙ` (the ideal `𝒩.comap R.subtype` of `R`). Then
`𝒪ₙ ⧸ 𝒩ₙ ≃+* ℤ ⧸ N ℤ`, and there is an ideal `J` of `𝒪ₙ` with `𝒩ₙ J = N 𝒪ₙ`; so `𝒩ₙ` is an
invertible `𝒪ₙ`-ideal, with inverse the fractional ideal `N⁻¹ J`.

The sources take `K` imaginary quadratic and `n ≥ 1`; neither is needed here (for `n = 0` the
hypothesis forces `N = 1`).

Source: B. H. Gross, *Kolyvagin's work on modular elliptic curves*, in *L-functions and
arithmetic* (Durham, 1989), London Math. Soc. Lecture Note Ser. 153, Cambridge Univ. Press, 1991,
235–256, §3, p. 238 ("Let n ≥ 1 be an integer which is prime to N, and let
$\mathcal{O}_n = \mathbb{Z} + n\mathcal{O}_K$ be the order of index n in $\mathcal{O}_K$. The ideal
$\mathcal{N}_n = \mathcal{N} \cap \mathcal{O}_n$ is an invertible $\mathcal{O}_n$-module with
$\mathcal{O}_n/\mathcal{N}_n \simeq \mathbb{Z}/N\mathbb{Z}$."); the proof is written out here. -/
theorem comap_order_quotient_ringEquiv_zmod_and_mul_eq_span {n N : ℕ} (hN : N ≠ 0)
    (hnN : n.Coprime N) {𝒩 : Ideal (𝓞 K)} (hcyc : IsAddCyclic (𝓞 K ⧸ 𝒩))
    (hcard : Nat.card (𝓞 K ⧸ 𝒩) = N) {R : Subring (𝓞 K)}
    (hR : (R : Set (𝓞 K)) = {x | ∃ (a : ℤ) (y : 𝓞 K), x = a + n * y}) :
    Nonempty (R ⧸ 𝒩.comap R.subtype ≃+* ZMod N) ∧
      ∃ J : Ideal R, 𝒩.comap R.subtype * J = Ideal.span {(N : R)} := by
  have hchar := charP_of_isAddCyclic hcyc hcard
  have : Finite (𝓞 K ⧸ 𝒩) := Nat.finite_of_card_ne_zero (hcard ▸ hN)
  let _ := Fintype.ofFinite (𝓞 K ⧸ 𝒩)
  let e := ZMod.ringEquiv (𝓞 K ⧸ 𝒩) (Fintype.card_eq_nat_card.trans hcard)
  have hNmem : (N : 𝓞 K) ∈ 𝒩 := natCast_mem_of_card hcard
  set I := 𝒩.comap R.subtype with hI
  -- the quotient
  let f : R →+* 𝓞 K ⧸ 𝒩 := (Ideal.Quotient.mk 𝒩).comp R.subtype
  have hker : RingHom.ker f = I := by
    rw [← RingHom.comap_ker, Ideal.mk_ker]
  have hsurj : Function.Surjective f := fun q => by
    obtain ⟨z, rfl⟩ := e.surjective q
    obtain ⟨a, rfl⟩ := ZMod.intCast_surjective z
    exact ⟨a, by simp [f]⟩
  refine ⟨⟨(Ideal.quotEquivOfEq hker.symm).trans
    ((RingHom.quotientKerEquivOfSurjective hsurj).trans e.symm)⟩, ?_⟩
  -- invertibility
  obtain ⟨u, v, huv⟩ := Nat.isCoprime_iff_coprime.mpr hnN
  have hNI : (N : R) ∈ I := by simpa [hI] using hNmem
  have hext := le_map_comap hnN hNmem hR
  obtain ⟨𝒩', h𝒩'⟩ : 𝒩 ∣ Ideal.span {(N : 𝓞 K)} :=
    Ideal.dvd_iff_le.mpr ((Ideal.span_singleton_le_iff_mem _).mpr hNmem)
  set J : Ideal R := (Ideal.span {(N : R)}).colon (I : Set R) with hJ
  refine ⟨J, le_antisymm ?_ ?_⟩
  · rw [Ideal.mul_le]
    intro i hi j hj
    rw [mul_comm]
    exact (Submodule.mem_colon.mp hj) i hi
  · rw [Ideal.span_singleton_le_iff_mem]
    have hNJ : (N : R) ∈ J := Submodule.mem_colon.mpr fun s _ =>
      Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    -- `n N ∈ 𝒩ₙ J`
    have key : ∀ x ∈ I.map R.subtype * 𝒩', ∃ y ∈ I * J, (y : 𝓞 K) = n * x := by
      intro x hx
      refine Submodule.mul_induction_on hx (fun a ha b hb => ?_) (fun x y ⟨y₁, h₁, e₁⟩
        ⟨y₂, h₂, e₂⟩ => ⟨y₁ + y₂, add_mem h₁ h₂, by push_cast [e₁, e₂]; ring⟩)
      induction ha using Submodule.span_induction generalizing b with
      | mem a ha =>
        obtain ⟨m, hm, rfl⟩ := ha
        have hbJ : (⟨n * b, mul_mem_order hR b⟩ : R) ∈ J := by
          refine Submodule.mem_colon.mpr fun p hp => ?_
          have hbp : b * p ∈ Ideal.span {(N : 𝓞 K)} := by
            rw [h𝒩', mul_comm b]
            exact Ideal.mul_mem_mul (by simpa [hI] using hp) hb
          obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp hbp
          refine Ideal.mem_span_singleton'.mpr ⟨⟨n * s, mul_mem_order hR s⟩, Subtype.ext ?_⟩
          simp only [smul_eq_mul, Subring.coe_mul, Subring.coe_natCast]
          linear_combination (n : 𝓞 K) * hs
        refine ⟨m * ⟨n * b, mul_mem_order hR b⟩, Ideal.mul_mem_mul hm hbJ, ?_⟩
        simp only [Subring.coe_mul, Subring.subtype_apply]; ring
      | zero => exact ⟨0, zero_mem _, by simp⟩
      | add a₁ a₂ _ _ ih₁ ih₂ =>
        obtain ⟨y₁, h₁, e₁⟩ := ih₁ b hb
        obtain ⟨y₂, h₂, e₂⟩ := ih₂ b hb
        exact ⟨y₁ + y₂, add_mem h₁ h₂, by push_cast [e₁, e₂]; ring⟩
      | smul r a _ ih =>
        obtain ⟨y, h, e'⟩ := ih (r * b) (𝒩'.mul_mem_left r hb)
        exact ⟨y, h, by rw [e', smul_eq_mul]; ring⟩
    have hNmap : (N : 𝓞 K) ∈ I.map R.subtype * 𝒩' := by
      have : (N : 𝓞 K) ∈ 𝒩 * 𝒩' := h𝒩' ▸ Ideal.mem_span_singleton_self _
      exact Ideal.mul_mono_left hext this
    obtain ⟨y, hy, ey⟩ := key _ hNmap
    have hy' : y = (n : R) * N := Subtype.ext (by simpa using ey)
    have hdecomp : (N : R) = (u : R) * ((n : R) * N) + (v : R) * ((N : R) * N) := by
      have := congrArg (Int.cast : ℤ → R) huv
      push_cast at this
      linear_combination (-(N : R)) * this
    rw [hdecomp]
    exact add_mem (Ideal.mul_mem_left _ _ (hy' ▸ hy))
      (Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul hNI hNJ))

/-- **The Heegner isogeny of conductor `n` is cyclic of degree `N`.** Let `K ⊂ ℂ` be an imaginary
quadratic field, embedded by `σ : K →+* ℂ`, let `𝒩` be an ideal of `𝓞 K` with `𝓞 K ⧸ 𝒩` cyclic
of order `N ≠ 0`, and let `n ≠ 0` be prime to `N`. Let `𝒪ₙ = ℤ + n 𝓞 K` (the subring `R` of
`𝓞 K`, viewed in `K` as the `ℤ`-submodule `O`), let `𝒩ₙ = 𝒩 ∩ 𝒪ₙ`, and let
`𝒩ₙ⁻¹ = {x ∈ K : x 𝒩ₙ ⊆ 𝒪ₙ}` (`Ninv`, the quotient `O / 𝒩ₙ` of `ℤ`-submodules of `K`). Then
`σ(𝒪ₙ)` and `σ(𝒩ₙ⁻¹)` are lattices in `ℂ` (discrete `ℤ`-submodules spanning `ℂ` over `ℝ`) with
`σ(𝒪ₙ) ⊆ σ(𝒩ₙ⁻¹)`, the quotient `σ(𝒩ₙ⁻¹) / σ(𝒪ₙ)` is cyclic of order `N`, and the map
`ℂ / σ(𝒪ₙ) → ℂ / σ(𝒩ₙ⁻¹)` induced by the identity of `ℂ` is surjective with kernel
`σ(𝒩ₙ⁻¹) / σ(𝒪ₙ)`, cyclic of order `N`.

As for `n = 1` (`NumberField.FractionalIdeal.heegner_isogeny_isAddCyclic_ker`), the isogeny
`ℂ/𝒪ₙ → ℂ/𝒩ₙ⁻¹` is stated as this surjective homomorphism of quotient groups with finite cyclic
kernel; the complex structure of the tori is not stated. The invertibility of `𝒩ₙ`
(`comap_order_quotient_ringEquiv_zmod_and_mul_eq_span`) is not a hypothesis: the proof shows
`𝒩ₙ⁻¹ = 𝒪ₙ + n 𝒩⁻¹` directly.

Source: B. H. Gross, *Kolyvagin's work on modular elliptic curves*, in *L-functions and
arithmetic* (Durham, 1989), London Math. Soc. Lecture Note Ser. 153, Cambridge Univ. Press, 1991,
235–256, §3, p. 238 ("Consequently the elliptic curve $\mathbb{C}/\mathcal{O}_n$ (with its cyclic
N-isogeny to $\mathbb{C}/\mathcal{N}_n^{-1}$) defines a complex point $x_n$ on $X_0(N)$."); the
proof is written out here. -/
theorem heegner_isogeny_conductor_isAddCyclic_ker [IsTotallyComplex K]
    (hK : Module.finrank ℚ K = 2) (σ : K →+* ℂ) {n N : ℕ} (hn : n ≠ 0) (hN : N ≠ 0)
    (hnN : n.Coprime N) {𝒩 : Ideal (𝓞 K)} (hcyc : IsAddCyclic (𝓞 K ⧸ 𝒩))
    (hcard : Nat.card (𝓞 K ⧸ 𝒩) = N) {R : Subring (𝓞 K)}
    (hR : (R : Set (𝓞 K)) = {x | ∃ (a : ℤ) (y : 𝓞 K), x = a + n * y}) :
    let ι : R →ₗ[ℤ] K := ((algebraMap (𝓞 K) K).comp R.subtype).toIntAlgHom.toLinearMap
    let O : Submodule ℤ K := LinearMap.range ι
    let Ninv : Submodule ℤ K := O / ((𝒩.comap R.subtype).restrictScalars ℤ).map ι
    let L₀ : Submodule ℤ ℂ := O.map σ.toIntAlgHom.toLinearMap
    let L₁ : Submodule ℤ ℂ := Ninv.map σ.toIntAlgHom.toLinearMap
    (∃ _ : DiscreteTopology L₀, IsZLattice ℝ L₀) ∧ (∃ _ : DiscreteTopology L₁, IsZLattice ℝ L₁) ∧
    ∃ h : L₀ ≤ L₁, IsAddCyclic (L₁ ⧸ L₀.comap L₁.subtype) ∧
      Nat.card (L₁ ⧸ L₀.comap L₁.subtype) = N ∧
      Function.Surjective (L₀.mapQ L₁ LinearMap.id h) ∧
      IsAddCyclic (LinearMap.ker (L₀.mapQ L₁ LinearMap.id h)) ∧
      Nat.card (LinearMap.ker (L₀.mapQ L₁ LinearMap.id h)) = N := by
  intro ι O Ninv L₀ L₁
  obtain ⟨u, v, huv⟩ := Nat.isCoprime_iff_coprime.mpr hnN
  have huvK : (u : K) * n + (v : K) * N = 1 := by
    have := congrArg (Int.cast : ℤ → K) huv
    push_cast at this
    exact this
  have hNmem : (N : 𝓞 K) ∈ 𝒩 := natCast_mem_of_card hcard
  have hext := le_map_comap hnN hNmem hR
  set φ := algebraMap (𝓞 K) K with hφ
  have hO : ∀ x : K, x ∈ O ↔ ∃ r ∈ R, φ r = x := fun x => by
    simp only [O, ι, LinearMap.mem_range]
    exact ⟨fun ⟨y, hy⟩ => ⟨y, y.2, hy⟩, fun ⟨r, hr, e⟩ => ⟨⟨r, hr⟩, e⟩⟩
  have hNinv : ∀ x : K, x ∈ Ninv ↔ ∀ r ∈ R, r ∈ 𝒩 → ∃ s ∈ R, φ s = x * φ r := fun x => by
    simp only [Ninv, Submodule.mem_div_iff_forall_mul_mem, Submodule.mem_map,
      Submodule.restrictScalars_mem, Ideal.mem_comap, hO]
    constructor
    · intro h r hr hr𝒩
      exact h _ ⟨⟨r, hr⟩, hr𝒩, rfl⟩
    · rintro h _ ⟨⟨r, hr⟩, hr𝒩, rfl⟩
      exact h r hr hr𝒩
  have h𝒩0 : (𝒩 : FractionalIdeal (𝓞 K)⁰ K) ≠ 0 := by
    rw [ne_eq, FractionalIdeal.coeIdeal_eq_zero]
    rintro rfl
    exact hN (by exact_mod_cast (Submodule.mem_bot _).mp hNmem)
  set F : FractionalIdeal (𝓞 K)⁰ K := (𝒩 : FractionalIdeal (𝓞 K)⁰ K)⁻¹ with hF
  have hmemF : ∀ x : K, x ∈ F ↔ ∀ m ∈ 𝒩, ∃ s, φ s = x * φ m := fun x => by
    rw [hF, FractionalIdeal.mem_inv_iff h𝒩0]
    constructor
    · intro h m hm
      exact (FractionalIdeal.mem_one_iff _).mp
        (h _ ((FractionalIdeal.mem_coeIdeal _).mpr ⟨m, hm, rfl⟩))
    · intro h y hy
      obtain ⟨m, hm, rfl⟩ := (FractionalIdeal.mem_coeIdeal _).mp hy
      exact (FractionalIdeal.mem_one_iff _).mpr (h m hm)
  -- the key inclusions
  have k1 : O ≤ Ninv := fun x hx => by
    obtain ⟨r, hr, rfl⟩ := (hO x).mp hx
    exact (hNinv _).mpr fun r' hr' _ => ⟨r * r', R.mul_mem hr hr', by rw [map_mul]⟩
  have k2 : ∀ y ∈ F, (n : K) * y ∈ Ninv := fun y hy => by
    refine (hNinv _).mpr fun r hr hr𝒩 => ?_
    obtain ⟨s, hs⟩ := (hmemF y).mp hy r hr𝒩
    exact ⟨n * s, mul_mem_order hR s, by rw [map_mul, hs, map_natCast]; ring⟩
  have k3 : ∀ x ∈ Ninv, x ∈ F := fun x hx => by
    refine (hmemF x).mpr fun m hm => ?_
    have := hext hm
    clear hm
    induction this using Submodule.span_induction with
    | mem a ha =>
      obtain ⟨r, hr, rfl⟩ := ha
      obtain ⟨s, _, hs⟩ := (hNinv x).mp hx r r.2 hr
      exact ⟨s, hs⟩
    | zero => exact ⟨0, by simp⟩
    | add a b _ _ iha ihb =>
      obtain ⟨s, hs⟩ := iha
      obtain ⟨t, ht⟩ := ihb
      exact ⟨s + t, by rw [map_add, hs, ht, map_add, mul_add]⟩
    | smul c a _ ih =>
      obtain ⟨s, hs⟩ := ih
      exact ⟨c * s, by rw [map_mul, hs, smul_eq_mul, map_mul]; ring⟩
  have k4 : ∀ y ∈ F, (n : K) * y ∈ O → ∃ s, φ s = y := fun y hy hny => by
    obtain ⟨r, -, hr⟩ := (hO _).mp hny
    obtain ⟨s, hs⟩ := (hmemF y).mp hy _ hNmem
    refine ⟨u * r + v * s, ?_⟩
    rw [map_add, map_mul, map_mul, hr, hs, map_intCast, map_intCast, map_natCast]
    linear_combination y * huvK
  have k5 : ∀ x ∈ Ninv, (N : K) * x ∈ O := fun x hx => by
    obtain ⟨s, hs, e⟩ := (hNinv x).mp hx N (_root_.natCast_mem R N) hNmem
    exact (hO _).mpr ⟨s, hs, by rw [e, map_natCast, mul_comm]⟩
  -- `y ↦ n y` induces `𝒩⁻¹ / 𝓞 K ≃ 𝒩ₙ⁻¹ / 𝒪ₙ`
  let P : Submodule ℤ Ninv := O.comap Ninv.subtype
  let g : (F : Submodule (𝓞 K) K) →+ Ninv :=
    { toFun := fun y => ⟨(n : K) * y, k2 y y.2⟩
      map_zero' := by ext; simp
      map_add' := fun a b => by ext; simp [mul_add] }
  let ψ : (F : Submodule (𝓞 K) K) →ₗ[ℤ] Ninv ⧸ P := P.mkQ ∘ₗ g.toIntLinearMap
  have hψ : Function.Surjective ψ := by
    intro q
    obtain ⟨⟨x, hx⟩, rfl⟩ := Submodule.Quotient.mk_surjective P q
    refine ⟨u • ⟨x, k3 x hx⟩, ?_⟩
    simp only [ψ, LinearMap.comp_apply, Submodule.mkQ_apply]
    rw [Submodule.Quotient.eq, Submodule.mem_comap]
    have e : (n : K) * ((u : ℤ) • x) - x = -((v : ℤ) • ((N : K) * x)) := by
      rw [zsmul_eq_mul, zsmul_eq_mul]
      linear_combination x * huvK
    change (n : K) * ((u : ℤ) • x) - x ∈ O
    rw [e]
    exact neg_mem (Submodule.smul_mem _ _ (k5 x hx))
  have hker : LinearMap.ker ψ =
      (((1 : FractionalIdeal (𝓞 K)⁰ K) : Submodule (𝓞 K) K).comap
        (F : Submodule (𝓞 K) K).subtype).restrictScalars ℤ := by
    ext y
    simp only [ψ, LinearMap.mem_ker, LinearMap.comp_apply, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero, Submodule.restrictScalars_mem, Submodule.mem_comap,
      Submodule.subtype_apply, FractionalIdeal.mem_coeToSubmodule]
    change (n : K) * y ∈ O ↔ (y : K) ∈ (1 : FractionalIdeal (𝓞 K)⁰ K)
    rw [FractionalIdeal.mem_one_iff]
    constructor
    · exact k4 y y.2
    · rintro ⟨s, hs⟩
      exact (hO _).mpr ⟨n * s, mul_mem_order hR s, by rw [map_mul, hs, map_natCast]⟩
  have h𝒩bot : 𝒩 ≠ ⊥ := fun h => h𝒩0 (by rw [h, FractionalIdeal.coeIdeal_bot])
  let eK : (Ninv ⧸ P) ≃+ 𝓞 K ⧸ 𝒩 :=
    (((ψ.quotKerEquivOfSurjective hψ).symm.trans (Submodule.quotEquivOfEq _ _ hker)).trans
      (Submodule.Quotient.restrictScalarsEquiv ℤ _)).toAddEquiv.trans
      (FractionalIdeal.invQuotientEquiv (L := K) 𝒩 h𝒩bot).toAddEquiv
  -- transport by `σ`
  have hσ : Function.Injective σ.toIntAlgHom.toLinearMap := σ.injective
  let eσ := Submodule.equivMapOfInjective _ hσ Ninv
  let eQ : (Ninv ⧸ P) ≃ₗ[ℤ] (L₁ ⧸ L₀.comap L₁.subtype) :=
    Submodule.Quotient.equiv P _ eσ (by
      ext ⟨z, hz⟩
      simp only [Submodule.mem_map, Submodule.mem_comap, Submodule.subtype_apply]
      constructor
      · rintro ⟨y, hy, hyz⟩
        have := congrArg Subtype.val hyz
        simp only [eσ, LinearEquiv.coe_coe] at this
        exact ⟨y, hy, this⟩
      · rintro ⟨x, hx, rfl⟩
        exact ⟨⟨x, k1 hx⟩, hx, Subtype.ext rfl⟩)
  let e : (L₁ ⧸ L₀.comap L₁.subtype) ≃+ 𝓞 K ⧸ 𝒩 := eQ.symm.toAddEquiv.trans eK
  -- the lattices
  have h : L₀ ≤ L₁ := Submodule.map_mono k1
  have hNK : (N : K) ≠ 0 := Nat.cast_ne_zero.mpr hN
  have hL₁ : L₁ ≤ FractionalIdeal.complexLattice σ
      (FractionalIdeal.spanSingleton (𝓞 K)⁰ (N : K)⁻¹) := by
    rintro z ⟨x, hx, rfl⟩
    refine FractionalIdeal.mem_complexLattice.mpr ⟨x, ?_, rfl⟩
    obtain ⟨r, -, hr⟩ := (hO _).mp (k5 x hx)
    refine (FractionalIdeal.mem_spanSingleton _).mpr ⟨r, ?_⟩
    rw [Algebra.smul_def, ← hφ, hr]
    field_simp
  have hL₀ : FractionalIdeal.complexLattice σ (FractionalIdeal.spanSingleton (𝓞 K)⁰ (n : K)) ≤
      L₀ := by
    intro z hz
    obtain ⟨x, hx, rfl⟩ := FractionalIdeal.mem_complexLattice.mp hz
    obtain ⟨c, rfl⟩ := (FractionalIdeal.mem_spanSingleton _).mp hx
    refine ⟨c • (n : K), (hO _).mpr ⟨n * c, mul_mem_order hR c, ?_⟩, rfl⟩
    rw [map_mul, map_natCast, Algebra.smul_def, ← hφ, mul_comm]
  have hd := FractionalIdeal.discreteTopology_complexLattice hK σ
    (FractionalIdeal.spanSingleton (𝓞 K)⁰ (N : K)⁻¹)
  have hd₁ : DiscreteTopology L₁ :=
    DiscreteTopology.of_continuous_injective (f := Submodule.inclusion hL₁)
      (continuous_inclusion hL₁) (Submodule.inclusion_injective hL₁)
  have hd₀ : DiscreteTopology L₀ :=
    DiscreteTopology.of_continuous_injective (f := Submodule.inclusion (h.trans hL₁))
      (continuous_inclusion (h.trans hL₁)) (Submodule.inclusion_injective (h.trans hL₁))
  have hn0 : FractionalIdeal.spanSingleton (𝓞 K)⁰ (n : K) ≠ 0 := by
    rw [ne_eq, FractionalIdeal.spanSingleton_eq_zero_iff]
    exact Nat.cast_ne_zero.mpr hn
  have hspan₀ : Submodule.span ℝ (L₀ : Set ℂ) = ⊤ :=
    top_unique ((FractionalIdeal.span_complexLattice σ hn0).symm.le.trans
      (Submodule.span_mono hL₀))
  have hspan₁ : Submodule.span ℝ (L₁ : Set ℂ) = ⊤ :=
    top_unique (hspan₀.symm.le.trans (Submodule.span_mono h))
  let e' := ((Submodule.kerMapQIdEquiv h).toAddEquiv).trans e
  refine ⟨⟨hd₀, ⟨hspan₀⟩⟩, ⟨hd₁, ⟨hspan₁⟩⟩, h,
    isAddCyclic_of_surjective e.symm.toAddMonoidHom e.symm.surjective,
    (Nat.card_congr e.toEquiv).trans hcard, fun z => ?_,
    isAddCyclic_of_surjective e'.symm.toAddMonoidHom e'.symm.surjective,
    (Nat.card_congr e'.toEquiv).trans hcard⟩
  induction z using Submodule.Quotient.induction_on with
  | H z => exact ⟨Submodule.Quotient.mk z, rfl⟩

end NumberField.RingOfIntegers

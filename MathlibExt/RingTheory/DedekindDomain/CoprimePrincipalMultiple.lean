module

public import Mathlib.RingTheory.DedekindDomain.Factorization
public import Mathlib.RingTheory.DedekindDomain.Ideal.Lemmas

/-!
# A principal multiple coprime to a given ideal

ATLAS `NumberTheoryI`, Lemma 3.16 (Section 3.3): in a Dedekind domain,
for nonzero ideals `I` and `I'` there is an ideal `J` coprime to `I'`
such that `I * J` is principal. This is the key step from which the
book deduces that every ideal of a Dedekind domain is generated by two
elements (Theorem 3.22) and that quotients by nonzero ideals are
principal ideal rings (Corollary 3.18); both of those consequences are
already available (`IsDedekindDomain.exists_eq_span_pair` in Mathlib
and `IsDedekindDomain.isPrincipalIdealRing_quotient` in MathlibExt).

The proof follows v1's argument
(`v1/Atlas/NumberTheoryI/code/CoprimePrincipal.lean`,
`Ideal.exists_coprime_mul_principal`): since `I * I' ≤ I` is nonzero,
`IsDedekindDomain.exists_sup_span_eq` gives `a` with
`I * I' ⊔ (a) = I`; writing `(a) = I * J`, coprimality of `J` and `I'`
then follows from `I * (I' ⊔ J) = I` by cancellation in the monoid of
ideals. The book proves the same lemma by a valuation (finite
approximation, Corollary 3.17) argument instead.

## Main results

* `Ideal.exists_isCoprime_mul_eq_span_singleton`: given nonzero ideals
  `I` and `I'` of a Dedekind domain, there are an ideal `J` coprime
  to `I'` and an element `x` with `I * J = Ideal.span {x}`.
-/

@[expose] public section

namespace Ideal

/-- Lemma 3.16 of ATLAS `NumberTheoryI`: in a Dedekind domain, every
nonzero ideal `I` has a principal multiple `I * J` with `J` coprime to
any prescribed nonzero ideal `I'`. -/
theorem exists_isCoprime_mul_eq_span_singleton
    {A : Type*} [CommRing A] [IsDedekindDomain A]
    {I I' : Ideal A} (hI : I ≠ ⊥) (hI' : I' ≠ ⊥) :
    ∃ (J : Ideal A) (x : A), IsCoprime J I' ∧ I * J = Ideal.span {x} := by
  have hle : I * I' ≤ I := Ideal.mul_le_left
  have hne : I * I' ≠ ⊥ := mul_ne_zero hI hI'
  obtain ⟨a, ha⟩ := IsDedekindDomain.exists_sup_span_eq hle hne
  have ha_le : Ideal.span {a} ≤ I := by
    rw [← ha]
    exact le_sup_right
  obtain ⟨J, hJ⟩ := Ideal.dvd_iff_le.mpr ha_le
  refine ⟨J, a, ?_, hJ.symm⟩
  rw [Ideal.isCoprime_iff_sup_eq]
  have h1 : I * (I' ⊔ J) = I * ⊤ := by
    rw [Ideal.mul_sup, Ideal.mul_top, ← hJ, ha]
  have h2 : I' ⊔ J = ⊤ := mul_left_cancel₀ hI h1
  rw [sup_comm]
  exact h2

end Ideal
